---
export type FilterOption = {
  id: string;
  label: string;
  count: number;
};

type Props = {
  filters: FilterOption[];
  gridId: string;
  ariaLabel?: string;
};

const { filters, gridId, ariaLabel = "Filter by category" } = Astro.props;
---

<div class="catalog-filter-bar" role="toolbar" aria-label={ariaLabel} data-target-grid={gridId}>
  {filters.map((f, idx) => (
    <button
      type="button"
      class:list={["catalog-filter-btn", { "is-active": idx === 0 }]}
      data-filter={f.id}
      aria-pressed={idx === 0 ? "true" : "false"}
    >
      <span>{f.label}</span>
      <span class="filter-count">({f.count})</span>
    </button>
  ))}
</div>

<style>
  .catalog-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
    padding: 8px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgba(18, 9, 34, 0.72);
    backdrop-filter: blur(10px);
    width: fit-content;
    max-width: 100%;
  }

  .catalog-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
  }

  .catalog-filter-btn:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }

  .catalog-filter-btn.is-active,
  .catalog-filter-btn[aria-pressed="true"] {
    background: rgba(168, 85, 247, 0.22);
    border-color: rgba(168, 85, 247, 0.55);
    color: #fff;
    box-shadow: 0 0 16px rgba(168, 85, 247, 0.28);
  }

  .filter-count {
    opacity: 0.75;
    font-weight: 600;
  }

  :global(.filterable-card-wrap) {
    display: flex;
  }

  :global(.filterable-card-wrap > .content-card) {
    width: 100%;
  }

  :global(.filterable-card-wrap[hidden]) {
    display: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".catalog-filter-bar").forEach((bar) => {
    const gridId = bar.dataset.targetGrid;
    const grid = gridId ? document.getElementById(gridId) : null;
    if (!grid) return;

    const buttons = bar.querySelectorAll<HTMLButtonElement>(".catalog-filter-btn");
    const items = grid.querySelectorAll<HTMLElement>(".filterable-card-wrap");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const selected = btn.dataset.filter || "all";

        buttons.forEach((other) => {
          const active = other === btn;
          other.classList.toggle("is-active", active);
          other.setAttribute("aria-pressed", active ? "true" : "false");
        });

        items.forEach((item) => {
          const match = selected === "all" || item.dataset.category === selected;
          item.hidden = !match;
        });
      });
    });
  });
</script>
