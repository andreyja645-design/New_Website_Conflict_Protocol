---
import { site } from "../lib/site";

type Props = {
  type: "pattern" | "technique" | "situation";
  hook: string;
  level?: string;
};

const { type, hook, level } = Astro.props;
const eyebrow =
  type === "pattern"
    ? "TACTICAL COMBAT DRILL"
    : type === "technique"
      ? "ACTIVE COUNTER-MOVE REHEARSAL"
      : "LIVE SCENARIO SIMULATION";
const body =
  type === "pattern"
    ? "The opponent AI runs this pressure tactic against you live. Maya tracks your response in real time, penalizing defensive J.A.D.E. and scoring composure under fire."
    : type === "technique"
      ? "Maya scores your use of this move under active adversarial pressure, right when your autonomic nervous system wants to freeze or donate a full defensive paragraph."
      : level
        ? `This exact high-stakes scenario is a playable level in the simulator: ${level}.`
        : "Rehearse this exact confrontation against an opponent calibrated to defeat you—while the stakes are blessedly fake.";
---

<aside id="practice-live" class="game-cta-terminal">
  <div class="corner-reticle reticle-tl"></div>
  <div class="corner-reticle reticle-tr"></div>
  <div class="corner-reticle reticle-bl"></div>
  <div class="corner-reticle reticle-br"></div>

  <div class="terminal-hud-header">
    <div class="terminal-tag">
      <span class="beacon-mini"></span>
      <span>MAYA AI // COMBAT SIMULATOR // FREE TIER</span>
    </div>
    <span class="terminal-status">● NEURAL DRILL READY</span>
  </div>

  <div class="terminal-body-content">
    <span class="terminal-kicker">{eyebrow}</span>
    <h2 class="terminal-title">{hook}</h2>
    <p class="terminal-desc">{body}</p>

    <div class="terminal-action-strip">
      <a href={site.gameUrl} class="terminal-play-btn" target="_blank" rel="noopener noreferrer">
        <span class="btn-glow"></span>
        <span class="btn-text">ENTER ARENA FREE</span>
        <span class="btn-arrow">➔</span>
      </a>
      <span class="terminal-subtext">Instant browser access • No card required • Real-time telemetry</span>
    </div>
  </div>
</aside>

<style>
  .game-cta-terminal {
    position: relative;
    max-width: 900px;
    margin-top: 56px;
    background: linear-gradient(135deg, rgba(26, 12, 48, 0.95) 0%, rgba(12, 6, 24, 0.98) 100%);
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 0 35px rgba(168, 85, 247, 0.25), 0 20px 50px rgba(0, 0, 0, 0.8);
  }

  /* Reticles */
  .corner-reticle {
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
    z-index: 2;
  }
  .reticle-tl { top: 6px; left: 6px; border-top: 2px solid var(--accent); border-left: 2px solid var(--accent); }
  .reticle-tr { top: 6px; right: 6px; border-top: 2px solid var(--accent); border-right: 2px solid var(--accent); }
  .reticle-bl { bottom: 6px; left: 6px; border-bottom: 2px solid var(--accent); border-left: 2px solid var(--accent); }
  .reticle-br { bottom: 6px; right: 6px; border-bottom: 2px solid var(--accent); border-right: 2px solid var(--accent); }

  .terminal-hud-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 18px;
    background: rgba(10, 5, 20, 0.9);
    border-bottom: 1px solid rgba(168, 85, 247, 0.3);
    font-family: var(--font-mono);
    font-size: 10.5px;
  }

  .terminal-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .beacon-mini {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .terminal-status {
    font-weight: 700;
    color: var(--emerald, #10b981);
    letter-spacing: 0.08em;
  }

  .terminal-body-content {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .terminal-kicker {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .terminal-title {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3.2vw, 2.1rem);
    font-weight: 900;
    color: #fff;
    margin: 0;
    line-height: 1.25;
    letter-spacing: 0.02em;
  }

  .terminal-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-soft);
    margin: 0;
    max-width: 680px;
  }

  .terminal-action-strip {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .terminal-play-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    border-radius: 8px;
    background: linear-gradient(135deg, #a855f7 0%, #ff2d9b 100%);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 0 24px rgba(168, 85, 247, 0.4);
    transition: all 0.25s ease;
    overflow: hidden;
  }

  .terminal-play-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 35px rgba(255, 45, 155, 0.6);
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .terminal-play-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  .terminal-subtext {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.06em;
  }
</style>
