---
import type { CardLink } from "../lib/contentLinks";

type Props = {
  card: CardLink;
};

const { card } = Astro.props;
const isTradingCard = Boolean(
  card.image?.includes("/cards/") ||
  card.eyebrow?.toLowerCase() === "pattern" ||
  card.eyebrow?.toLowerCase() === "technique"
);
---

<article class:list={["content-card", { "is-trading-card": isTradingCard }]}>
  <div class="card-shimmer-sweep"></div>
  <div class="corner-reticle reticle-tl"></div>
  <div class="corner-reticle reticle-tr"></div>
  <div class="corner-reticle reticle-bl"></div>
  <div class="corner-reticle reticle-br"></div>

  <a href={card.href} class="content-card-link">
    {card.image && (
      <div class:list={["card-img-wrap", { "trading-art-wrap": isTradingCard }]}>
        <img src={card.image} alt={card.title} loading="lazy" class="card-img" />
        {!isTradingCard && <div class="card-img-scrim"></div>}
      </div>
    )}
    <div class="card-body-content">
      <span class="card-eyebrow-tag">
        <span class="eyebrow-beacon"></span>
        <span>{card.eyebrow}</span>
      </span>
      <h2 class="card-heading">{card.title}</h2>
      <p class="card-desc">{card.oneLiner}</p>
      <div class="card-action-row">
        <span>View Dossier</span>
        <span class="card-arrow">➔</span>
      </div>
    </div>
  </a>
</article>

<style>
  .content-card {
    position: relative;
    background: rgba(18, 9, 34, 0.88);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
  }

  .content-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 0 25px rgba(168, 85, 247, 0.38), 0 16px 40px rgba(0, 0, 0, 0.85);
  }

  /* Holographic light shimmer sweep */
  .card-shimmer-sweep {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgba(255, 255, 255, 0.06) 35%,
      rgba(168, 85, 247, 0.16) 45%,
      rgba(255, 45, 155, 0.1) 55%,
      transparent 70%
    );
    transform: translateX(-100%);
    transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    z-index: 4;
  }

  .content-card:hover .card-shimmer-sweep {
    transform: translateX(100%);
  }

  /* Corner reticles with hover expansion */
  .corner-reticle {
    position: absolute;
    width: 8px;
    height: 8px;
    pointer-events: none;
    z-index: 3;
    transition: all 0.22s ease;
  }
  .reticle-tl { top: 6px; left: 6px; border-top: 1.5px solid var(--accent); border-left: 1.5px solid var(--accent); }
  .reticle-tr { top: 6px; right: 6px; border-top: 1.5px solid var(--accent); border-right: 1.5px solid var(--accent); }
  .reticle-bl { bottom: 6px; left: 6px; border-bottom: 1.5px solid var(--accent); border-left: 1.5px solid var(--accent); }
  .reticle-br { bottom: 6px; right: 6px; border-bottom: 1.5px solid var(--accent); border-right: 1.5px solid var(--accent); }

  .content-card:hover .corner-reticle {
    border-color: #fff;
    filter: drop-shadow(0 0 4px var(--accent));
  }
  .content-card:hover .reticle-tl { top: 4px; left: 4px; }
  .content-card:hover .reticle-tr { top: 4px; right: 4px; }
  .content-card:hover .reticle-bl { bottom: 4px; left: 4px; }
  .content-card:hover .reticle-br { bottom: 4px; right: 4px; }

  .content-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .card-img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: #090510;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s ease;
  }

  .content-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-img-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18, 9, 34, 0.95) 0%, rgba(18, 9, 34, 0.2) 60%, transparent 100%);
  }

  .card-body-content {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .card-eyebrow-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow-beacon {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }

  .card-heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    color: #fff;
    margin: 0;
  }

  .card-desc {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--muted);
    flex: 1;
    margin: 0;
  }

  .card-action-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 12px;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: #fff;
  }

  .card-arrow {
    color: var(--accent);
    transition: transform 0.2s;
  }

  .content-card:hover .card-arrow {
    transform: translateX(4px);
    color: #fff;
  }

  /* Uncropped Trading Cards (Patterns & Techniques) */
  .trading-art-wrap {
    height: auto;
    aspect-ratio: 2 / 3;
    background: #090510;
  }

  .trading-art-wrap .card-img {
    object-fit: contain;
    object-position: center;
  }

  .content-card.is-trading-card:hover .card-img {
    transform: scale(1.02);
  }

  .content-card.is-trading-card .card-body-content {
    padding: 14px 16px 16px;
    background: rgba(14, 7, 26, 0.95);
    border-top: 1px solid rgba(168, 85, 247, 0.2);
    gap: 6px;
  }

  .content-card.is-trading-card .card-heading {
    font-size: 1.12rem;
  }

  .content-card.is-trading-card .card-desc {
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .content-card.is-trading-card .card-action-row {
    padding-top: 10px;
    margin-top: 2px;
  }
</style>
