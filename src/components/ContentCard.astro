---
import type { CardLink } from "../lib/contentLinks";

type Props = {
  card: CardLink;
};

const { card } = Astro.props;
const isTradingCard = Boolean(
  card.image?.includes("/cards/") ||
  card.eyebrow?.toLowerCase() === "pattern" ||
  card.eyebrow?.toLowerCase() === "technique"
);
---

<article class:list={["content-card", { "is-trading-card": isTradingCard }]}>

  <a href={card.href} class="content-card-link">
    {card.image ? (
      <div class:list={["card-img-wrap", { "trading-art-wrap": isTradingCard }]}>
        <img src={card.image} alt="" loading="lazy" class="card-img" />
      </div>
    ) : (
      isTradingCard && (
        <div class="card-img-wrap trading-art-wrap card-fallback-art" aria-hidden="true">
          <div class="fallback-neon-frame">
            <img src="/assets/cp-logo.webp" alt="" width="56" height="56" loading="lazy" class="fallback-logo" />
            <span class="fallback-eyebrow">{card.eyebrow.toUpperCase()} MOVE</span>
            <strong class="fallback-title">{card.title}</strong>
          </div>
        </div>
      )
    )}
    <div class="card-body-content">
      <h2 class="card-heading">{card.title}</h2>
      <p class="card-desc">{card.oneLiner}</p>
      <div class="card-action-row">
        <span>{card.eyebrow === "Situation" ? "Read the conversation" : `Read the ${card.eyebrow.toLowerCase()}`}</span>
        <span class="card-arrow">➔</span>
      </div>
    </div>
  </a>
</article>

<style>
  .content-card {
    position: relative;
    background: rgba(18, 9, 34, 0.88);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
  }

  .content-card:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .content-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
    box-shadow: 0 0 25px rgba(168, 85, 247, 0.38), 0 16px 40px rgba(0, 0, 0, 0.85);
  }

  .content-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .card-img-wrap {
    position: relative;
    aspect-ratio: 3 / 2;
    width: 100%;
    background: #090510;
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card-body-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .card-heading {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.3;
    color: #fff;
    margin: 0;
  }

  .card-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-soft);
    flex: 1;
    margin: 0;
  }

  .card-action-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 12px;
    margin-top: 4px;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
  }

  .card-arrow {
    color: var(--accent);
    transition: transform 0.2s;
  }

  .content-card:hover .card-arrow {
    transform: translateX(4px);
    color: #fff;
  }

  /* Uncropped Trading Cards (Patterns & Techniques) */
  .trading-art-wrap {
    height: auto;
    aspect-ratio: 2 / 3;
    background: #090510;
  }

  .trading-art-wrap .card-img {
    object-fit: contain;
    object-position: center;
  }

  .card-fallback-art {
    display: flex;
    padding: 18px;
    background:
      radial-gradient(circle at 50% 28%, rgba(168, 85, 247, 0.24), transparent 65%),
      linear-gradient(160deg, #160a2a 0%, #090510 100%);
  }

  .fallback-neon-frame {
    width: 100%;
    height: 100%;
    border: 1.5px solid rgba(168, 85, 247, 0.5);
    border-radius: 12px;
    padding: 24px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    text-align: center;
    background: rgba(12, 6, 24, 0.72);
    box-shadow: inset 0 0 28px rgba(168, 85, 247, 0.16);
  }

  .fallback-logo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid rgba(47, 184, 255, 0.45);
    box-shadow: 0 0 18px rgba(168, 85, 247, 0.35);
  }

  .fallback-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--accent-cool, #2fb8ff);
  }

  .fallback-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.2;
    color: #fff;
    text-transform: uppercase;
  }

</style>
