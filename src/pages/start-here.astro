---
import BaseLayout from "../layouts/BaseLayout.astro";
import GameCTA from "../components/GameCTA.astro";
---

<BaseLayout
  title="Start here | The Conflict Protocol"
  description="For the moment your brain goes blank under pressure: why it happens, what to say first, and where to go next."
  canonical="/start-here/"
  image="/assets/pages/start-here-hero.webp"
  imageAlt="A pressure moment paused long enough to choose the next line."
  bodyClass="start-page"
>
  <div class="start-page-shell">
    <!-- Ambient glowing accents -->
    <div class="bg-glow-orb orb-1"></div>
    <div class="bg-glow-orb orb-2"></div>

    <!-- Top HUD Navigation / Status Breadcrumb -->
    <div class="hud-status-strip">
      <div class="hud-status-left">
        <span class="hud-radar-beacon"></span>
        <span class="hud-mono-tag">MAYA AI // NEURAL PROTOCOL // STAGE 01: ORIENTATION</span>
      </div>
      <div class="hud-status-right">
        <span class="hud-shield-indicator">● COGNITIVE BUFFER ONLINE</span>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- HERO SECTION: BALANCED 2-COLUMN COMMAND CENTER               -->
    <!-- ============================================================ -->
    <header class="start-hero-grid">
      <!-- Left Column: Copy & Immediate Action -->
      <div class="hero-left-col">
        <div class="tactical-badge">
          <span class="badge-icon">⚡</span>
          <span>AUTONOMIC NERVOUS SYSTEM RECOVERY</span>
        </div>

        <h1 class="hero-main-title">
          WHEN YOUR BRAIN GOES BLANK,<br />
          <span class="title-gradient-highlight">START SMALLER.</span>
        </h1>

        <p class="hero-lede-text">
          You know the feeling. The confrontation ends, your stomach slowly uncoils, and the perfect,
          devastating sentence strolls in three hours late like it pays rent.
        </p>

        <p class="hero-sub-text">
          In the heat of the moment, though, you froze. Or you said yes too fast. Or you started explaining,
          then defending the explanation, apologizing for needing oxygen and a calendar.
          <strong>We are fixing that right here.</strong>
        </p>

        <!-- Use This First: Immediate Script Anchor Box -->
        <div class="first-response-card">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="first-response-header">
            <span class="first-response-pill">⚡ USE THIS SCRIPT FIRST</span>
            <span class="first-response-meta">EMERGENCY BUFFER PHRASE</span>
          </div>

          <div class="first-response-script">
            "I need a second to answer that clearly."
          </div>

          <div class="first-response-footer">
            <button class="copy-script-btn" data-script="I need a second to answer that clearly." title="Copy to clipboard">
              <span class="btn-copy-icon">📋</span>
              <span class="btn-copy-label">COPY SCRIPT</span>
            </button>
            <a href="#five-lines" class="jump-arsenal-link">
              <span>View the 5 Universal Pressure Lines ➔</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Maya Tactical Co-Pilot Card -->
      <div class="hero-right-col">
        <div class="maya-dossier-frame">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="dossier-hud-top">
            <div class="dossier-tag">
              <span class="radar-ping-mini"></span>
              <span>MAYA AI // TACTICAL TELEMETRY</span>
            </div>
            <span class="dossier-status">LIVE INTERCEPT</span>
          </div>

          <div class="dossier-image-box">
            <img
              src="/assets/pages/start-here-hero.webp"
              alt="A high pressure moment paused long enough to pick the next line"
              width="900"
              height="600"
              class="dossier-img"
            />
            <div class="scanlines-overlay"></div>
            <div class="dossier-image-badge">
              <span>FIG 1.0: THE ADRENALINE FREEZE</span>
            </div>
          </div>

          <div class="dossier-coach-quote">
            <div class="quote-header">
              <span class="quote-avatar">🤖</span>
              <span class="quote-author">MAYA COACH ADVISORY:</span>
            </div>
            <p class="quote-content">
              "Under acute social pressure, adrenaline diverts blood from your prefrontal cortex to your limbs.
              You cannot think creatively. <strong>Do not try to win the debate; simply buy 5 seconds.</strong>"
            </p>
          </div>
        </div>
      </div>
    </header>

    <!-- ============================================================ -->
    <!-- SECTION 2: THE BIOLOGICAL ARCHITECTURE (ALIGNED 2-CARD GRID)  -->
    <!-- ============================================================ -->
    <section class="bio-architecture-section">
      <div class="section-badge-bar">
        <span class="section-mono-kicker">SECTION 01 // PSYCHOLOGICAL DIAGNOSTIC</span>
        <h2 class="section-block-title">THE ANATOMY OF THE FREEZE</h2>
      </div>

      <div class="two-card-dossier-grid">
        <!-- Card 1: Emerald HUD Law - Biological Reflex -->
        <div class="tactical-dossier-card card-emerald">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="card-top-tag-row">
            <span class="tag-badge badge-emerald">THE PSYCHOLOGICAL LAW</span>
            <span class="tag-status">BIOLOGY ≠ MORAL DEFECT</span>
          </div>

          <h3 class="card-title">Freezing is Not a Character Flaw</h3>

          <p class="card-paragraph">
            A blank mind under pressure is normal. Annoying, deeply inconvenient at board meetings and dinner tables,
            but <strong>not a moral defect</strong>. Your autonomic nervous system is simply trying to keep the situation from
            escalating by picking the fastest survival door:
          </p>

          <div class="survival-doors-list">
            <div class="survival-door-item">
              <span class="door-code">01 // FREEZE</span>
              <span class="door-text">Vocal cord paralysis, waiting for the threat to move past.</span>
            </div>
            <div class="survival-door-item">
              <span class="door-code">02 // FAWN</span>
              <span class="door-text">Agreeing, flattering, smiling to disarm their aggression.</span>
            </div>
            <div class="survival-door-item">
              <span class="door-code">03 // EXPLAIN</span>
              <span class="door-text">Writing paragraphs of justification to prove you are reasonable.</span>
            </div>
          </div>

          <div class="card-axiom-box axiom-emerald">
            "Your nervous system chose the exit door before your intellect even sat down at the table."
          </div>
        </div>

        <!-- Card 2: Crimson Alert - The Cost of the Fast Exit -->
        <div class="tactical-dossier-card card-crimson">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="card-top-tag-row">
            <span class="tag-badge badge-crimson">VULNERABILITY ASSESSMENT</span>
            <span class="tag-status">HIGH FRICTION TRAPS</span>
          </div>

          <h3 class="card-title">The High Cost of the Fast Exit</h3>

          <p class="card-paragraph">
            The problem with the biological emergency door is that it is ruinously expensive in adult life.
            Every time you trade a rushed surrender for immediate quiet, the interest compounds:
          </p>

          <div class="trap-breakdown-list">
            <div class="trap-item">
              <div class="trap-icon">❌</div>
              <div class="trap-desc">
                <strong>The Instant "Yes"</strong>
                <p>Becomes an entire weekend of work you didn't have and smoldering resentment.</p>
              </div>
            </div>
            <div class="trap-item">
              <div class="trap-icon">❌</div>
              <div class="trap-desc">
                <strong>The Reflex Apology</strong>
                <p>Legitimizes their false framing and erases their bad behavior from the record.</p>
              </div>
            </div>
            <div class="trap-item">
              <div class="trap-icon">❌</div>
              <div class="trap-desc">
                <strong>The J.A.D.E. Monologue</strong>
                <p>Offers reasons that become an all-you-can-eat buffet for someone looking for leverage.</p>
              </div>
            </div>
          </div>

          <div class="card-axiom-box axiom-crimson">
            "Defending your right to say no gives them veto power over your calendar."
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- SECTION 3: WIDE TACTICAL CALLOUT (MINDSET PIVOT)             -->
    <!-- ============================================================ -->
    <section class="wide-callout-banner">
      <div class="corner-reticle reticle-tl"></div>
      <div class="corner-reticle reticle-tr"></div>
      <div class="corner-reticle reticle-bl"></div>
      <div class="corner-reticle reticle-br"></div>

      <div class="callout-inner-content">
        <div class="callout-badge-line">
          <span class="callout-sparkle">✦</span>
          <span>TACTICAL CORE PRINCIPLE</span>
        </div>

        <h2 class="callout-heading">YOU DO NOT NEED SUDDEN COURAGE.</h2>

        <p class="callout-text">
          Courage is great. It is also completely unreliable when your heart is hammering at 140 BPM.
          <strong>Prepared words are bulletproof.</strong> You do not need a grand, Hollywood transformation arc.
          You only need one or two pre-loaded sentences you can reach while your brain is still buffering.
        </p>

        <div class="callout-stats-row">
          <div class="c-stat-item">
            <span class="c-stat-val">1 LINE</span>
            <span class="c-stat-lbl">To break the rush</span>
          </div>
          <div class="c-stat-arrow">➔</div>
          <div class="c-stat-item">
            <span class="c-stat-val">5 SECONDS</span>
            <span class="c-stat-lbl">To let logic return</span>
          </div>
          <div class="c-stat-arrow">➔</div>
          <div class="c-stat-item">
            <span class="c-stat-val">0 REGRET</span>
            <span class="c-stat-lbl">Held your ground</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- SECTION 4: THE THREE TACTICAL DOORS (ALIGNED 3-CARD PORTAL)  -->
    <!-- ============================================================ -->
    <section class="three-doors-section">
      <div class="section-badge-bar text-center">
        <span class="section-mono-kicker">SECTION 02 // NAVIGATION MATRIX</span>
        <h2 class="section-block-title">THE THREE ENTRY DOORS</h2>
        <p class="section-block-sub">Where to go based on what you are facing right now:</p>
      </div>

      <div class="doors-grid-three">
        <!-- Door 1: Patterns -->
        <a href="/patterns/" class="door-portal-card door-patterns">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="door-header">
            <span class="door-index">01</span>
            <span class="door-badge badge-purple">14 PROFILES</span>
          </div>

          <h3 class="door-title">THE PATTERNS</h3>
          <p class="door-lead">"What are they doing to me?"</p>
          <p class="door-description">
            Guilt-trips, gaslighting, DARVO, moving goalposts, public shaming, and empathy traps.
            Spot the mechanical pattern before it turns into a trial of your character.
          </p>

          <div class="door-action-bar">
            <span>Explore Patterns</span>
            <span class="door-arrow">➔</span>
          </div>
        </a>

        <!-- Door 2: Techniques -->
        <a href="/techniques/" class="door-portal-card door-techniques">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="door-header">
            <span class="door-index">02</span>
            <span class="door-badge badge-cyan">12 TECHNIQUES</span>
          </div>

          <h3 class="door-title">THE TECHNIQUES</h3>
          <p class="door-lead">"What do I do back?"</p>
          <p class="door-description">
            Grey Rock, Broken Record, Fogging, Boundary Setting, and Aikido Reframing.
            Surgical tools for staying boringly steady when someone is baiting you into a speech.
          </p>

          <div class="door-action-bar">
            <span>Arm Counter-Moves</span>
            <span class="door-arrow">➔</span>
          </div>
        </a>

        <!-- Door 3: Situations -->
        <a href="/situations/" class="door-portal-card door-situations">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="door-header">
            <span class="door-index">03</span>
            <span class="door-badge badge-emerald">8 SCENES</span>
          </div>

          <h3 class="door-title">THE SITUATIONS</h3>
          <p class="door-lead">"What do I literally say in this room?"</p>
          <p class="door-description">
            Worked real-life scripts: boss expanding the scope, parent guilt-trips, workplace freeze,
            and silent treatments. Verbatim dialogue you can say tomorrow.
          </p>

          <div class="door-action-bar">
            <span>View Worked Scenes</span>
            <span class="door-arrow">➔</span>
          </div>
        </a>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- SECTION 5: THE FIVE UNIVERSAL PRESSURE LINES                 -->
    <!-- ============================================================ -->
    <section class="five-lines-section" id="five-lines">
      <div class="section-badge-bar">
        <span class="section-mono-kicker">SECTION 03 // EMERGENCY ARSENAL</span>
        <h2 class="section-block-title">FIVE LINES FOR ANY PRESSURED MOMENT</h2>
        <p class="section-block-sub">
          If you read nothing else on this website, memorize these five sentences. They are not magic tricks.
          <strong>They are a pause with shoes on.</strong>
        </p>
      </div>

      <div class="tactical-rack-container">
        <!-- Line 1 -->
        <div class="line-rack-item">
          <div class="line-meta-col">
            <span class="line-num">01</span>
            <span class="line-purpose">BUY ONE SECOND</span>
          </div>
          <div class="line-content-col">
            <div class="line-script-text">"I need a second to answer that clearly."</div>
            <p class="line-explain">Stops the artificial urgency clock immediately without declaring war. Signals calm authority.</p>
          </div>
          <div class="line-action-col">
            <button class="copy-script-btn" data-script="I need a second to answer that clearly.">
              <span class="btn-copy-icon">📋</span>
              <span class="btn-copy-label">COPY</span>
            </button>
          </div>
        </div>

        <!-- Line 2 -->
        <div class="line-rack-item">
          <div class="line-meta-col">
            <span class="line-num">02</span>
            <span class="line-purpose">REFUSE TO COMMIT</span>
          </div>
          <div class="line-content-col">
            <div class="line-script-text">"I need to check before I commit."</div>
            <p class="line-explain">Puts a mandatory buffer between their request and your answer. Replaces the automatic 'yes'.</p>
          </div>
          <div class="line-action-col">
            <button class="copy-script-btn" data-script="I need to check before I commit.">
              <span class="btn-copy-icon">📋</span>
              <span class="btn-copy-label">COPY</span>
            </button>
          </div>
        </div>

        <!-- Line 3 -->
        <div class="line-rack-item">
          <div class="line-meta-col">
            <span class="line-num">03</span>
            <span class="line-purpose">SLOW THE ROOM DOWN</span>
          </div>
          <div class="line-content-col">
            <div class="line-script-text">"I am not answering this on the spot."</div>
            <p class="line-explain">Draws a hard perimeter around aggressive ambushes in public meetings or hallway confrontations.</p>
          </div>
          <div class="line-action-col">
            <button class="copy-script-btn" data-script="I am not answering this on the spot.">
              <span class="btn-copy-icon">📋</span>
              <span class="btn-copy-label">COPY</span>
            </button>
          </div>
        </div>

        <!-- Line 4 -->
        <div class="line-rack-item">
          <div class="line-meta-col">
            <span class="line-num">04</span>
            <span class="line-purpose">RESET A RUSHED YES</span>
          </div>
          <div class="line-content-col">
            <div class="line-script-text">"I answered too quickly. I need to revisit that."</div>
            <p class="line-explain">The golden undo button. You are allowed to take back a capitulation made under duress.</p>
          </div>
          <div class="line-action-col">
            <button class="copy-script-btn" data-script="I answered too quickly. I need to revisit that.">
              <span class="btn-copy-icon">📋</span>
              <span class="btn-copy-label">COPY</span>
            </button>
          </div>
        </div>

        <!-- Line 5 -->
        <div class="line-rack-item">
          <div class="line-meta-col">
            <span class="line-num">05</span>
            <span class="line-purpose">MAKE PRESSURE CHOOSE</span>
          </div>
          <div class="line-content-col">
            <div class="line-script-text">"If you need an answer right now, it is no for now."</div>
            <p class="line-explain">The ultimate pressure reversal. If they refuse to give you time, the automatic outcome is a decline.</p>
          </div>
          <div class="line-action-col">
            <button class="copy-script-btn" data-script="If you need an answer right now, it is no for now.">
              <span class="btn-copy-icon">📋</span>
              <span class="btn-copy-label">COPY</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Bottom Tactical Call to Action -->
    <section class="game-cta-wrapper">
      <GameCTA
        type="situation"
        hook="Rehearse the moment pressure tries to choose your answer for you."
      />
    </section>
  </div>
</BaseLayout>

<style>
  /* ============================================================ */
  /* START HERE PAGE // MAYA AI TACTICAL HUD (STYLE 1)            */
  /* ============================================================ */
  .start-page-shell {
    max-width: 1280px;
    margin: 0 auto;
    padding: 30px 24px 80px;
    position: relative;
    z-index: 1;
  }

  /* Atmospheric glow orbs */
  .bg-glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: -1;
  }
  .orb-1 {
    top: -50px;
    right: -100px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.14) 0%, transparent 70%);
  }
  .orb-2 {
    top: 800px;
    left: -150px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(47, 184, 255, 0.08) 0%, transparent 70%);
  }

  /* Top HUD Status Strip */
  .hud-status-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 18px;
    background: rgba(19, 10, 36, 0.7);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 10px;
    margin-bottom: 40px;
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .hud-status-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hud-radar-beacon {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    position: relative;
  }
  .hud-radar-beacon::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    animation: beacon-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes beacon-ping {
    75%, 100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .hud-mono-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .hud-shield-indicator {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--emerald);
    letter-spacing: 0.08em;
  }

  /* Corner Reticles */
  .corner-reticle {
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
    z-index: 2;
  }
  .reticle-tl { top: 6px; left: 6px; border-top: 2px solid var(--accent); border-left: 2px solid var(--accent); }
  .reticle-tr { top: 6px; right: 6px; border-top: 2px solid var(--accent); border-right: 2px solid var(--accent); }
  .reticle-bl { bottom: 6px; left: 6px; border-bottom: 2px solid var(--accent); border-left: 2px solid var(--accent); }
  .reticle-br { bottom: 6px; right: 6px; border-bottom: 2px solid var(--accent); border-right: 2px solid var(--accent); }

  /* ============================================================ */
  /* HERO COMMAND CENTER                                          */
  /* ============================================================ */
  .start-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
    gap: 44px;
    align-items: center;
    margin-bottom: 70px;
  }

  @media (max-width: 960px) {
    .start-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .hero-left-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .tactical-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 5px 12px;
    border-radius: 9999px;
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.35);
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .hero-main-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: 0.03em;
    color: #fff;
    text-transform: uppercase;
  }

  .title-gradient-highlight {
    background: linear-gradient(135deg, #c084fc 0%, #ff2d9b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 25px rgba(168, 85, 247, 0.5);
  }

  .hero-lede-text {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-soft);
  }

  .hero-sub-text {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .hero-sub-text strong {
    color: #fff;
  }

  /* First Response Box */
  .first-response-card {
    position: relative;
    background: linear-gradient(135deg, rgba(22, 11, 42, 0.9) 0%, rgba(12, 6, 24, 0.95) 100%);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    padding: 20px 22px;
    box-shadow: 0 0 30px rgba(168, 85, 247, 0.25), 0 10px 30px rgba(0,0,0,0.8);
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 10px;
  }

  .first-response-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .first-response-pill {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 800;
