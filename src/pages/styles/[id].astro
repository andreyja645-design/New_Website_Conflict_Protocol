---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { COMMUNICATION_STYLES, type CommunicationStyle } from "../../lib/communicationStyles";

export async function getStaticPaths() {
  return COMMUNICATION_STYLES.map((style, index) => {
    const prevStyle = index > 0 ? COMMUNICATION_STYLES[index - 1] : COMMUNICATION_STYLES[COMMUNICATION_STYLES.length - 1];
    const nextStyle = index < COMMUNICATION_STYLES.length - 1 ? COMMUNICATION_STYLES[index + 1] : COMMUNICATION_STYLES[0];
    return {
      params: { id: style.id },
      props: { style, prevStyle, nextStyle }
    };
  });
}

type Props = {
  style: CommunicationStyle;
  prevStyle: CommunicationStyle;
  nextStyle: CommunicationStyle;
};

const { style, prevStyle, nextStyle } = Astro.props;
const canonicalPath = `/styles/${style.id}/`;
---

<BaseLayout
  title={`${style.label} | Communication Styles`}
  description={style.detail}
  canonical={canonicalPath}
  image={style.image}
  imageAlt={`${style.label} - Signature Combat Archetype Artwork`}
  bodyClass="style-detail-page"
>
  <div class="style-detail-shell shell">
    <!-- Atmospheric glow orbs -->
    <div class="bg-glow-orb orb-1"></div>
    <div class="bg-glow-orb orb-2"></div>

    <!-- Top Maya HUD Status Strip -->
    <div class="hud-status-strip">
      <div class="hud-status-left">
        <span class="hud-radar-beacon" style={`background: ${style.badgeColor};`}></span>
        <span class="hud-mono-tag">MAYA AI // COMBAT DOSSIER // {style.label.toUpperCase()}</span>
      </div>
      <div class="hud-status-right">
        <span class="hud-shield-indicator">● {style.categoryLabel.toUpperCase()} // VULNERABILITY: {style.stats.vulnerabilityLevel.toUpperCase()}</span>
      </div>
    </div>

    <!-- Breadcrumb Back Link -->
    <nav class="breadcrumb-nav">
      <a href="/styles/" class="back-link">
        <span class="back-arrow">←</span>
        <span>ALL COMMUNICATION STYLES</span>
      </a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">{style.label}</span>
    </nav>

    <!-- 2-Column Command Center Layout -->
    <div class="detail-grid">
      <!-- Left Column: Tactical Analysis & Mechanics -->
      <main class="detail-main-col">
        <div class="archetype-hero-header">
          <div class="tactical-badge" style={`background: rgba(168, 85, 247, 0.14); border-color: ${style.badgeColor}; color: ${style.badgeColor};`}>
            <span class="badge-icon">⚡</span>
            <span>{style.categoryLabel}</span>
          </div>

          <h1 class="archetype-title">{style.label}</h1>

          <!-- Signature Tagline Quote Box -->
          <div class="signature-tagline-box">
            <div class="quote-mark">“</div>
            <p class="tagline-text">{style.tagline}</p>
          </div>
        </div>

        <!-- Section 1: Tactical Diagnostic Breakdown -->
        <section class="dossier-card">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="dossier-card-header">
            <span class="dossier-card-icon">🧠</span>
            <h2>MAYA AI TACTICAL DIAGNOSTIC</h2>
          </div>
          <p class="dossier-text">{style.detail}</p>
        </section>

        <!-- Section 2: Observed Combat Behaviors -->
        <section class="dossier-card">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="dossier-card-header">
            <span class="dossier-card-icon">🎯</span>
            <h2>OBSERVED COMBAT BEHAVIORS</h2>
          </div>
          <p class="section-subtext">How this archetype behaves under acute interpersonal pressure:</p>
          <ul class="habits-list">
            {style.habits.map((habit) => (
              <li class="habit-item">
                <span class="habit-bullet" style={`color: ${style.badgeColor};`}>▶</span>
                <span>{habit}</span>
              </li>
            ))}
          </ul>
        </section>

        <!-- Section 3: Tactical Directive (Correction or Cultivation) -->
        <section class="dossier-card directive-card">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="dossier-card-header">
            <span class="dossier-card-icon">💡</span>
            <h2>TACTICAL DIRECTIVE & COUNTER-MEASURE</h2>
          </div>
          <p class="directive-text">{style.counterMeasure}</p>
        </section>

        <!-- Section 4: Telemetry Metrics -->
        <section class="telemetry-panel">
          <div class="metric-block">
            <span class="metric-label">FRAME INTEGRITY</span>
            <span class="metric-val" style={`color: ${style.badgeColor};`}>{style.stats.frameControl}%</span>
            <div class="metric-meter">
              <div class="meter-fill" style={`width: ${style.stats.frameControl}%; background: ${style.badgeColor};`}></div>
            </div>
          </div>
          <div class="metric-block">
            <span class="metric-label">ROOM TEMPERATURE SHIFT</span>
            <span class="metric-val-text">{style.stats.temperatureShift}</span>
          </div>
          <div class="metric-block">
            <span class="metric-label">VULNERABILITY LEVEL</span>
            <span class={`metric-pill pill-${style.tone}`}>{style.stats.vulnerabilityLevel}</span>
          </div>
        </section>

        <!-- Prev / Next Archetype Navigation -->
        <div class="adjacent-nav">
          <a href={`/styles/${prevStyle.id}/`} class="adjacent-link prev-link">
            <span class="adj-dir">← PREVIOUS ARCHETYPE</span>
            <span class="adj-title">{prevStyle.label}</span>
          </a>
          <a href={`/styles/${nextStyle.id}/`} class="adjacent-link next-link">
            <span class="adj-dir">NEXT ARCHETYPE →</span>
            <span class="adj-title">{nextStyle.label}</span>
          </a>
        </div>
      </main>

      <!-- Right Column: Sticky Poster Artwork Frame -->
      <aside class="detail-sidebar-col">
        <div class="sticky-poster-wrapper">
          <div class="maya-poster-frame">
            <div class="corner-reticle reticle-tl"></div>
            <div class="corner-reticle reticle-tr"></div>
            <div class="corner-reticle reticle-bl"></div>
            <div class="corner-reticle reticle-br"></div>

            <div class="poster-hud-top">
              <span class="hud-tag">LIFETIME COMBAT IDENTITY</span>
              <span class="hud-serial">FIG // {style.id.toUpperCase()}</span>
            </div>

            <div class="poster-img-container">
              <img
                src={style.image}
                alt={`${style.label} - Conflict Protocol Poster Art`}
                width="576"
                height="1024"
                class="poster-img"
              />
              <div class="poster-scanlines"></div>
            </div>

            <!-- Maya Coach Prompt Card -->
            <div class="coach-quote-box">
              <div class="coach-header">
                <span class="coach-avatar">🤖</span>
                <span class="coach-label">MAYA AI FIELD ADVISORY:</span>
              </div>
              <p class="coach-quote">
                {style.category === "trap" 
                  ? "Pressure exposes habits. If you find yourself in this posture, pause for 5 seconds and reset your frame before replying."
                  : "Hold this posture consistently. When the opponent realizes force cannot dislodge your boundary, their momentum dissipates."}
              </p>
            </div>

            <!-- Test in Arena Button -->
            <a href="/play/" class="arena-launch-btn">
              <span>TEST IN COMBAT ARENA</span>
              <span class="btn-arrow">➔</span>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .style-detail-shell {
    max-width: 1240px;
    margin: 0 auto;
    padding: 30px 24px 90px;
    position: relative;
    z-index: 1;
  }

  /* Atmospheric glow orbs */
  .bg-glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: -1;
  }
  .orb-1 {
    top: -40px;
    right: -80px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.16) 0%, transparent 70%);
  }
  .orb-2 {
    top: 700px;
    left: -120px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(47, 184, 255, 0.1) 0%, transparent 70%);
  }

  /* Maya HUD Status Strip */
  .hud-status-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 18px;
    margin-bottom: 24px;
    border-radius: 8px;
    background: rgba(14, 7, 26, 0.8);
    border: 1px solid var(--line);
    backdrop-filter: blur(12px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .hud-status-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hud-radar-beacon {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    position: relative;
  }
  .hud-radar-beacon::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    animation: beacon-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes beacon-ping {
    75%, 100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .hud-mono-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .hud-shield-indicator {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--emerald, #10b981);
    letter-spacing: 0.08em;
  }

  /* Breadcrumb Navigation */
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 32px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: #fff;
    text-shadow: 0 0 8px var(--accent);
  }

  .breadcrumb-separator {
    color: var(--muted);
  }
  .breadcrumb-current {
    color: #fff;
  }

  /* 2-Column Detail Grid */
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 420px);
    gap: 48px;
    align-items: start;
  }

  @media (max-width: 960px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Main Column */
  .detail-main-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .archetype-hero-header {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tactical-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 5px 12px;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid;
  }

  .archetype-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    font-weight: 900;
    line-height: 1.08;
    color: #fff;
    letter-spacing: 0.02em;
    margin: 0;
    text-transform: uppercase;
  }

  /* Signature Tagline Quote Box */
  .signature-tagline-box {
    position: relative;
    background: rgba(18, 9, 34, 0.7);
    border-left: 3px solid var(--accent);
    border-radius: 0 12px 12px 0;
    padding: 16px 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .tagline-text {
    font-size: 1.2rem;
    font-weight: 600;
    font-style: italic;
    color: #e2e8f0;
    line-height: 1.5;
    margin: 0;
  }

  /* Dossier Cards */
  .dossier-card {
    position: relative;
    background: rgba(16, 8, 30, 0.8);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    backdrop-filter: blur(12px);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
  }

  .corner-reticle {
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
    z-index: 2;
  }
  .reticle-tl { top: 6px; left: 6px; border-top: 2px solid var(--accent); border-left: 2px solid var(--accent); }
  .reticle-tr { top: 6px; right: 6px; border-top: 2px solid var(--accent); border-right: 2px solid var(--accent); }
  .reticle-bl { bottom: 6px; left: 6px; border-bottom: 2px solid var(--accent); border-left: 2px solid var(--accent); }
  .reticle-br { bottom: 6px; right: 6px; border-bottom: 2px solid var(--accent); border-right: 2px solid var(--accent); }

  .dossier-card-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .dossier-card-header h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .dossier-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #cbd5e1;
    margin: 0;
  }

  .section-subtext {
    font-size: 0.95rem;
    color: var(--text-soft);
    margin: 0;
  }

  .habits-list {
    list-style: none;
    padding: 0;
    margin: 6px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .habit-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.98rem;
    color: #e2e8f0;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 10px 14px;
  }

  .habit-bullet {
    font-size: 10px;
  }

  .directive-card {
    border-color: rgba(168, 85, 247, 0.35);
    background: linear-gradient(135deg, rgba(22, 11, 42, 0.9) 0%, rgba(14, 7, 28, 0.9) 100%);
  }

  .directive-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #fff;
    margin: 0;
    font-weight: 500;
  }

  /* Telemetry Panel */
  .telemetry-panel {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    background: rgba(12, 6, 24, 0.7);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 18px;
  }

  @media (max-width: 640px) {
    .telemetry-panel {
      grid-template-columns: 1fr;
    }
  }

  .metric-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .metric-val {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 800;
  }

  .metric-val-text {
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
  }

  .metric-meter {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    overflow: hidden;
  }

  .meter-fill {
    height: 100%;
    border-radius: 999px;
  }

  .metric-pill {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 9999px;
    text-transform: uppercase;
  }
  .pill-good { background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; color: #10b981; }
  .pill-bad { background: rgba(244, 63, 94, 0.15); border: 1px solid #f43f5e; color: #f43f5e; }
  .pill-warn { background: rgba(234, 179, 8, 0.15); border: 1px solid #eab308; color: #eab308; }
  .pill-neutral { background: rgba(148, 163, 184, 0.15); border: 1px solid #94a3b8; color: #cbd5e1; }

  /* Adjacent Navigation */
  .adjacent-nav {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 10px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .adjacent-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    padding: 12px 18px;
    border-radius: 10px;
    background: rgba(18, 9, 34, 0.6);
    border: 1px solid var(--line);
    transition: all 0.2s ease;
    flex: 1;
  }
  .adjacent-link:hover {
    background: rgba(168, 85, 247, 0.15);
    border-color: rgba(168, 85, 247, 0.5);
    transform: translateY(-2px);
  }
  .next-link {
    text-align: right;
  }

  .adj-dir {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  .adj-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    color: #fff;
  }

  /* Sidebar Column */
  .sticky-poster-wrapper {
    position: sticky;
    top: 90px;
  }

  .maya-poster-frame {
    position: relative;
    background: rgba(16, 8, 30, 0.9);
    border: 1.5px solid var(--line-strong);
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 0 35px rgba(168, 85, 247, 0.25), 0 15px 40px rgba(0, 0, 0, 0.85);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .poster-hud-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 8px;
  }

  .hud-tag {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.12em;
  }
  .hud-serial {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 0.1em;
  }

  .poster-img-container {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    background: #000;
    border: 1px solid rgba(168, 85, 247, 0.35);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.7);
  }

  .poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .poster-scanlines {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.3) 50%);
    background-size: 100% 3px;
    opacity: 0.25;
    pointer-events: none;
  }

  .coach-quote-box {
    background: rgba(0, 0, 0, 0.4);
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .coach-header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 800;
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .coach-quote {
    font-size: 0.88rem;
    line-height: 1.5;
    color: #e2e8f0;
    margin: 0;
  }

  .arena-launch-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #a855f7 0%, #ff2d9b 100%);
    color: #fff;
    padding: 13px 20px;
    border-radius: 10px;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    box-shadow: 0 0 20px rgba(255, 45, 155, 0.4);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .arena-launch-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(255, 45, 155, 0.65);
  }
  .btn-arrow {
    font-size: 15px;
    transition: transform 0.2s;
  }
  .arena-launch-btn:hover .btn-arrow {
    transform: translateX(4px);
  }
</style>
