---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";

const rawGameUrl = site.gameUrl;
const hasValidGameUrl = Boolean(rawGameUrl && rawGameUrl !== "#practice-live" && !rawGameUrl.includes("localhost"));

if (import.meta.env.PROD && !hasValidGameUrl) {
  throw new Error(
    "BUILD ERROR: PUBLIC_GAME_URL must be configured with a production URL before building. It cannot be empty, '#practice-live', or a localhost address."
  );
}

const gameUrl = hasValidGameUrl ? rawGameUrl : null;

const opponentCards = [
  {
    name: "The Toxic Boss",
    slug: "scope-creep",
    role: "EXPLOITATION & SHAMING",
    line: "Owns your calendar, your credit, and your confidence — every push framed as loyalty, every refusal treated as a career threat.",
    image: "/assets/play/character-boss.webp",
    patternLink: "/patterns/scope-creep/",
    patternLabel: "Learn the Scope Creep pattern ➔"
  },
  {
    name: "The Gaslighter Friend",
    slug: "gaslighting",
    role: "COVERT GASLIGHTING",
    line: "Kyra — your closest friend, slowly making you the unreliable one. Every distortion wrapped in \"I'm telling you this because I actually care.\"",
    image: "/assets/play/character-gaslighter.webp",
    patternLink: "/patterns/gaslighting/",
    patternLabel: "Learn the Gaslighting pattern ➔"
  },
  {
    name: "The Guilt-Trip Parent",
    slug: "guilt-trip",
    role: "EMOTIONAL BLACKMAIL",
    line: "They gave up everything for you — and they'll remind you of it forever. The sigh, the comparison, the childhood sacrifice surfaced at exactly the wrong moment.",
    image: "/assets/play/character-parent.webp",
    patternLink: "/patterns/guilt-trip/",
    patternLabel: "Learn the Guilt Trip pattern ➔"
  },
  {
    name: "The Narcissistic Partner",
    slug: "silent-treatment",
    role: "DEVALUATION & GRANDIOSITY",
    line: "Every win you share becomes a threat. Every gift is almost right. Every silence is a punishment.",
    image: "/assets/play/character-narcissist.webp",
    patternLink: "/patterns/silent-treatment/",
    patternLabel: "Learn the Silent Treatment pattern ➔"
  }
];

const skillCards = [
  {
    name: "Grey Rock",
    slug: "grey-rock",
    oneLiner: "Dull, flat, unrewarding facts. Starves the manipulator of emotional fuel.",
    image: "/assets/play/skill-grey-rock.webp",
    link: "/techniques/grey-rock/"
  },
  {
    name: "Fogging",
    slug: "fogging",
    oneLiner: "Agreeing with the piece of truth without accepting the unfair accusation.",
    image: "/assets/play/skill-fogging.webp",
    link: "/techniques/fogging/"
  },
  {
    name: "Broken Record",
    slug: "broken-record",
    oneLiner: "Calmly holding a single sentence boundary without escalating volume or tone.",
    image: "/assets/play/skill-broken-record.webp",
    link: "/techniques/broken-record/"
  },
  {
    name: "Aikido Reframe",
    slug: "aikido",
    oneLiner: "Redirecting aggressive pressure back into a concrete project constraint.",
    image: "/assets/play/skill-aikido.webp",
    link: "/techniques/aikido/"
  }
];
---

<BaseLayout
  title="Play Free | Conflict Protocol"
  description="You always think of the right answer three hours later. Here you get to practice it — against someone who fights back. Free, in your browser, no signup."
  canonical="/play/"
  image="/assets/play/maya-hero.webp"
  bodyClass="play-page"
>
  <div class="play-page-shell">
    <!-- Ambient glow orbs -->
    <div class="play-glow-orb orb-1"></div>
    <div class="play-glow-orb orb-2"></div>

    <!-- ============================================================ -->
    <!-- 1. HERO — THE PROMISE, THEN THE REVEAL                       -->
    <!-- ============================================================ -->
    <section class="play-hero-wrap">
      <!-- Ambient video loop in background -->
      <div class="hero-video-backdrop">
        <video
          autoplay
          loop
          muted
          playsinline
          class="backdrop-video-el"
          poster="/assets/play/maya-hero.webp"
        >
          <source src="/assets/play/ambient-rain.mp4" type="video/mp4" />
        </video>
        <div class="backdrop-gradient-scrim"></div>
        <div class="backdrop-scanlines"></div>
      </div>

      <div class="play-hero-content">
        <!-- Status Eyebrow -->
        <div class="play-status-pill">
          <span class="pulse-beacon-dot"></span>
          <span>CONFLICT PROTOCOL // LIVE COMBAT SIMULATOR</span>
        </div>

        <!-- The Promise Headline -->
        <div class="hero-hook-lead">
          <span class="hook-icon">⚡</span>
          <span>YOU ALWAYS THINK OF THE RIGHT ANSWER THREE HOURS LATER.</span>
        </div>
        <h1 class="play-hero-headline">
          <span class="neon-highlight-magenta">HERE YOU GET TO PRACTICE IT —</span><br />
          <span class="neon-highlight-violet">AGAINST SOMEONE WHO FIGHTS BACK.</span>
        </h1>

        <!-- Kill The Three Objections In One Line -->
        <p class="objection-killer-strip">
          <span class="objection-badge">FREE</span>
          <span class="objection-dot">•</span>
          <span class="objection-badge">IN YOUR BROWSER</span>
          <span class="objection-dot">•</span>
          <span class="objection-badge">NO DOWNLOAD, NO SIGNUP</span>
        </p>

        <!-- The Single Master Action Button (Nothing Competing With It) -->
        <div class="hero-single-cta-wrap">
          {gameUrl ? (
            <a class="play-master-btn" href={gameUrl} target="_blank" rel="noopener noreferrer">
              <span class="btn-sparkle">⚔️</span>
              <span class="btn-main-text">PLAY FREE ➔</span>
            </a>
          ) : (
            <a class="play-master-btn is-disabled" href="#practice-live" aria-disabled="true">
              <span class="btn-sparkle">⚔️</span>
              <span class="btn-main-text">PLAY FREE (COMING SOON)</span>
            </a>
          )}
        </div>

        <!-- Hero Maya Visual Unit with HUD Reticles -->
        <div class="hero-maya-hud-unit">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="maya-hud-top-bar">
            <div class="hud-left-meta">
              <span class="hud-ping-dot"></span>
              <span class="hud-label-text">MAYA AI // TACTICAL CO-PILOT</span>
            </div>
            <span class="hud-status-badge">NEURAL LINK CONNECTED</span>
          </div>

          <div class="maya-portrait-box">
            <img
              src="/assets/play/maya-hero.webp"
              alt="Maya AI — Neural tactical coach in Conflict Protocol"
              class="maya-hero-img"
              width="600"
              height="400"
            />
            <div class="portrait-scanlines"></div>
            <div class="portrait-tag-pill">
              <span>ACTIVE SESSION READY // COMBAT DRILL #01</span>
            </div>
          </div>

          <div class="maya-hud-bottom-quote">
            "I analyze their manipulation move in real time and score your counter. Type your actual words. Do not let them rush your frame."
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2. "WHAT ACTUALLY HAPPENS" — 3 STEPS, WITH REAL SCREENSHOTS  -->
    <!-- ============================================================ -->
    <section class="play-section" id="how-it-works">
      <div class="section-title-wrap text-center">
        <span class="section-kicker">STEP-BY-STEP BREAKDOWN</span>
        <h2 class="section-heading">WHAT ACTUALLY HAPPENS</h2>
        <p class="section-subtitle">
          Nobody understands the game from a generic description. Here is how an encounter unfolds under live fire:
        </p>
      </div>

      <div class="three-steps-vertical-flow">
        <!-- Step 1 -->
        <article class="step-card">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="step-meta-side">
            <span class="step-number-tag">STEP 01</span>
            <h3 class="step-title">They open with a real manipulation move</h3>
            <p class="step-desc">
              The opponent drops an authentic high-pressure line — shifting blame, tone-policing, or baiting guilt.
              Not a canned robotic template, but a dynamic scene designed to test your biological freeze reflex.
            </p>
            <div class="step-status-chip chip-threat">
              <span>▲ THREAT ATTACK DETECTED</span>
            </div>
          </div>

          <div class="step-screen-side">
            <div class="screenshot-hud-frame">
              <img
                src="/assets/play/step-1-crop.png"
                alt="Opponent opens with a real manipulation move"
                class="screenshot-img"
                loading="lazy"
              />
              <div class="screenshot-scanlines"></div>
              <span class="screenshot-badge">LIVE TURN 01 // OPPONENT ATTACK</span>
            </div>
          </div>
        </article>

        <!-- Step 2 -->
        <article class="step-card step-card-reverse">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="step-meta-side">
            <span class="step-number-tag">STEP 02</span>
            <h3 class="step-title">You type your own reply — not multiple choice</h3>
            <p class="step-desc">
              No multiple-choice training wheels. You type your actual response into the composer box under real-time pressure,
              exactly as you would in a high-stakes email, Slack message, or boardroom face-to-face confrontation.
            </p>
            <div class="step-status-chip chip-typing">
              <span>⚡ LIVE COMPOSER INPUT</span>
            </div>
          </div>

          <div class="step-screen-side">
            <div class="screenshot-hud-frame">
              <img
                src="/assets/play/step-2-crop.png"
                alt="Player typing their own reply in the composer"
                class="screenshot-img"
                loading="lazy"
              />
              <div class="screenshot-scanlines"></div>
              <span class="screenshot-badge">FREE-FORM INPUT // NO CANNED ANSWERS</span>
            </div>
          </div>
        </article>

        <!-- Step 3 -->
        <article class="step-card">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="step-meta-side">
            <span class="step-number-tag">STEP 03</span>
            <h3 class="step-title">You get scored on what it actually did to them</h3>
            <p class="step-desc">
              Instant psychological telemetry. Did you hold your frame? Did you slip into defensive J.A.D.E.?
              Composure deltas, opponent heat changes, and landed counter-technique chips show what your words actually accomplished.
            </p>
            <div class="step-status-chip chip-score">
              <span>✔ TELEMETRY & TACTICAL GRADE</span>
            </div>
          </div>

          <div class="step-screen-side">
            <div class="screenshot-hud-frame">
              <img
                src="/assets/play/step-3-crop.png"
                alt="Move analysis scoring the turn"
                class="screenshot-img"
                loading="lazy"
              />
              <div class="screenshot-scanlines"></div>
              <span class="screenshot-badge">TURN EVALUATION // HEAT & COMPOSURE DELTAS</span>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 3. THE TRAILER — ONE, NOT SEVEN                              -->
    <!-- ============================================================ -->
    <section class="play-section" id="trailer">
      <div class="section-title-wrap text-center">
        <span class="section-kicker">TACTICAL RECONNAISSANCE</span>
        <h2 class="section-heading">SEE IT IN ACTION</h2>
        <p class="section-subtitle">Click to watch a 10-second combat sequence under live pressure:</p>
      </div>

      <div class="trailer-player-container">
        <div class="corner-reticle reticle-tl"></div>
        <div class="corner-reticle reticle-tr"></div>
        <div class="corner-reticle reticle-bl"></div>
        <div class="corner-reticle reticle-br"></div>

        <div class="trailer-hud-header">
          <div class="trailer-tag-left">
            <span class="pulse-beacon-dot"></span>
            <span>TRANSMISSION // GAMEPLAY TEASER</span>
          </div>
          <span class="trailer-status-tag">1080P // TACTICAL AUDIO ACTIVE</span>
        </div>

        <div class="video-media-wrapper">
          <video
            controls
            playsinline
            preload="metadata"
            class="trailer-video-element"
            poster="/assets/play/step-1-move.webp"
          >
            <source src="/assets/play/trailer.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>

        <div class="trailer-hud-footer">
          <span>Simulation renders entirely client-side. Zero lag, zero installation.</span>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 4. THE COMBAT ENGINE // NOT A CHATBOT. AN ADVERSARY.         -->
    <!-- ============================================================ -->
    <section class="play-section combat-engine-section" id="combat-engine">
      <div class="section-title-wrap text-center">
        <div class="engine-status-badge">
          <span class="pulse-beacon-dot"></span>
          <span>PARADIGM SHIFT // THE COMBAT ENGINE</span>
        </div>
        <h2 class="section-heading engine-main-heading">
          STOP PRACTICING WITH AI THAT AGREES WITH YOU.<br />
          <span class="neon-highlight-magenta">FIGHT CONVERSATIONS THAT DON'T.</span>
        </h2>
        <p class="section-subtitle engine-lead-para">
          Conflict Protocol is not an AI chatbot that happens to talk about conflict.
          It is a game designed around the <strong>mechanics of conflict</strong>.
        </p>
      </div>

      <!-- Core Philosophical Contrast Banner -->
      <div class="engine-manifesto-box">
        <div class="corner-reticle reticle-tl"></div>
        <div class="corner-reticle reticle-tr"></div>
        <div class="corner-reticle reticle-bl"></div>
        <div class="corner-reticle reticle-br"></div>
        <div class="manifesto-left-tag">
          <span class="manifesto-icon">⚡</span>
          <span>THE CORE RULE</span>
        </div>
        <p class="manifesto-quote">
          "A conventional chatbot wants to help you. It wants to be useful. It doesn't actually want to defeat you.
          <strong>In Conflict Protocol, the AI is your opponent.</strong> Mechanically, its job is to bait you into overexplaining,
          destabilize your emotional state, and break your boundary."
        </p>
      </div>

      <!-- Compact Side-by-Side Comparison Matrix -->
      <div class="engine-comparison-grid">
        <!-- Card 1: Standard AI Chatbot -->
        <article class="compare-card compare-chatbot">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="compare-header">
            <span class="compare-role-tag">NORMAL AI CHATBOT</span>
            <h3 class="compare-title">The Helpful Assistant</h3>
            <span class="compare-status-indicator status-assistant">COOPERATIVE // PASSIVE</span>
          </div>

          <ul class="compare-feature-list">
            <li>
              <span class="feat-bullet">✕</span>
              <div>
                <strong>Wants you to succeed:</strong> Politeness and cooperation are hard-coded into its objective function.
              </div>
            </li>
            <li>
              <span class="feat-bullet">✕</span>
              <div>
                <strong>Gives advice instead of pressure:</strong> Tells you "here's a good phrase to use," but never tests if you can speak it while panicked.
              </div>
            </li>
            <li>
              <span class="feat-bullet">✕</span>
              <div>
                <strong>Failure has zero stakes:</strong> Give a weak, defensive answer and it responds: <em>"That's understandable! Try this next time."</em> Nothing happened.
              </div>
            </li>
            <li>
              <span class="feat-bullet">✕</span>
              <div>
                <strong>Disposable chat:</strong> No memory of previous concessions. No tactical punishment for second-guessing yourself.
              </div>
            </li>
          </ul>

          <div class="compare-summary-bar chatbot-bar">
            <span>Core Lesson: "Here is a better sentence."</span>
          </div>
        </article>

        <!-- Card 2: Conflict Protocol Opponent -->
        <article class="compare-card compare-protocol">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="compare-header">
            <span class="compare-role-tag highlight-accent">CONFLICT PROTOCOL ARENA</span>
            <h3 class="compare-title highlight-neon">The Live Adversary</h3>
            <span class="compare-status-indicator status-adversary">OPPONENT // ACTIVE COMBAT</span>
          </div>

          <ul class="compare-feature-list">
            <li>
              <span class="feat-bullet highlight-check">✔</span>
              <div>
                <strong>Actively tries to defeat you:</strong> Baits guilt, applies urgency, and maneuvers you into defensive overexplaining (J.A.D.E.).
              </div>
            </li>
            <li>
              <span class="feat-bullet highlight-check">✔</span>
              <div>
                <strong>Visceral manipulation testing:</strong> Evaluates whether you took the bait, held your frame, or surrendered your ground.
              </div>
            </li>
            <li>
              <span class="feat-bullet highlight-check">✔</span>
              <div>
                <strong>Failure actually matters:</strong> Overexplain? <code class="delta-bad">FRAME ▼</code>. Defend? <code class="delta-bad">HEAT ▲</code>. Opponent exploits opening: <strong>BOUNDARY BROKEN</strong>.
              </div>
            </li>
            <li>
              <span class="feat-bullet highlight-check">✔</span>
              <div>
                <strong>Persistent combat loop:</strong> Opponents remember previous concessions and exploit them in later turns. Action ➔ Consequence ➔ Mastery.
              </div>
            </li>
          </ul>

          <div class="compare-summary-bar protocol-bar">
            <span>Core Lesson: "You just took the bait. Adapt and counter."</span>
          </div>
        </article>
      </div>

      <!-- Action-Consequence Fighting Game Loop Strip -->
      <div class="engine-consequence-ribbon">
        <div class="corner-reticle reticle-tl"></div>
        <div class="corner-reticle reticle-br"></div>
        <div class="ribbon-label">
          <span class="pulse-beacon-dot"></span>
          <span>THE COMBAT LOOP // WHY FAILURE MATTERS</span>
        </div>
        <div class="loop-steps-track">
          <div class="loop-step-chip">
            <span class="loop-num">01</span>
            <span class="loop-action">You Overexplain</span>
          </div>
          <span class="loop-arrow">➔</span>
          <div class="loop-step-chip chip-metric">
            <span class="loop-num">02</span>
            <span class="loop-action delta-bad">FRAME ▼</span>
          </div>
          <span class="loop-arrow">➔</span>
          <div class="loop-step-chip chip-metric">
            <span class="loop-num">03</span>
            <span class="loop-action delta-bad">HEAT ▲</span>
          </div>
          <span class="loop-arrow">➔</span>
          <div class="loop-step-chip chip-danger">
            <span class="loop-num">04</span>
            <span class="loop-action">Tactic: Guilt Hook</span>
          </div>
          <span class="loop-arrow">➔</span>
          <div class="loop-step-chip chip-broken">
            <span class="loop-num">05</span>
            <span class="loop-action">BOUNDARY BROKEN</span>
          </div>
        </div>
        <div class="ribbon-footer-takeaway">
          <span>Closer to a fighting game than ChatGPT: Action ➔ Consequence ➔ Understanding ➔ Adaptation ➔ Retry.</span>
        </div>
      </div>

      <!-- What the Game Actually Tracks (Canonical Telemetry) -->
      <div class="telemetry-block-wrap">
        <div class="telemetry-block-header">
          <span class="telemetry-kicker">REAL HUD SYSTEMS // CANONICAL TELEMETRY</span>
          <h3 class="telemetry-title">WHAT THE GAME ACTUALLY TRACKS</h3>
          <p class="telemetry-desc">
            No vague chatbot advice. The Conflict Protocol engine scores your autonomic posture against live, ticking battle systems:
          </p>
        </div>

        <div class="telemetry-metrics-grid">
          <!-- 1. HEAT -->
          <div class="telemetry-metric-card">
            <div class="metric-top-row">
              <span class="metric-hud-code">HUD BAR // 01</span>
              <span class="metric-tag tag-heat">HEAT</span>
            </div>
            <h4 class="metric-name">The Live Pressure Bar</h4>
            <p class="metric-def">
              The conversation's internal temperature (0–100). Escalates whenever the opponent drops bait or you react defensively. As heat climbs through its 5 stages, per-turn composure drain accelerates.
            </p>
          </div>

          <!-- 2. STANDING -->
          <div class="telemetry-metric-card">
            <div class="metric-top-row">
              <span class="metric-hud-code">HUD BAR // 02</span>
              <span class="metric-tag tag-leverage">STANDING</span>
            </div>
            <h4 class="metric-name">Opponent Currency</h4>
            <p class="metric-def">
              Social leverage bar named per opponent: <strong>Leverage</strong> on the Boss, <strong>Rapport</strong> on the Gaslighter Friend & Parent, and <strong>Supply</strong> on the Narcissist. Each adversary has a distinct currency.
            </p>
          </div>

          <!-- 3. COMPOSURE -->
          <div class="telemetry-metric-card">
            <div class="metric-top-row">
              <span class="metric-hud-code">HUD BADGE // 03</span>
              <span class="metric-tag tag-composure">COMPOSURE</span>
            </div>
            <h4 class="metric-name">Autonomic Stamina</h4>
            <p class="metric-def">
              The numeric badge under Maya's composer. Your biological reserve to stay grounded. Recovers (+1/turn) when composed; burns up to −4/turn under volatile heat.
            </p>
          </div>

          <!-- 4. THE 5 HEAT STAGES & RUPTURE -->
          <div class="telemetry-metric-card">
            <div class="metric-top-row">
              <span class="metric-hud-code">LADDER // 04</span>
              <span class="metric-tag tag-rupture">HEAT STAGES</span>
            </div>
            <h4 class="metric-name">Composed ➔ Rupture</h4>
            <p class="metric-def">
              Five escalating stages: <strong>Composed</strong> (0–24, +1/turn) ➔ <strong>Friction</strong> (25–49, −1) ➔ <strong>Heated</strong> (50–74, −2) ➔ <strong>Volatile</strong> (75–99, −3) ➔ <strong>Rupture</strong> (100, −4/turn).
            </p>
          </div>

          <!-- 5. SCORE & TURN -->
          <div class="telemetry-metric-card">
            <div class="metric-top-row">
              <span class="metric-hud-code">HUD TILES // 05</span>
              <span class="metric-tag tag-frame">SCORE & TURN</span>
            </div>
            <h4 class="metric-name">Live Evaluation</h4>
            <p class="metric-def">
              Uncapped raw scoring and turn counter. Maya evaluates your typed words in real time: tracking frame resistance, penalizing defensive J.A.D.E., and awarding chips for counter-moves.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 5. WHO YOU FACE — THE EMOTIONAL HOOK                         -->
    <!-- ============================================================ -->
    <section class="play-section" id="opponents">
      <div class="section-title-wrap text-center">
        <span class="section-kicker">COMBAT PROFILES</span>
        <h2 class="section-heading">WHO YOU FACE</h2>
        <p class="section-subtitle">
          Four distinct psychological combat archetypes. This is where you recognize the exact dynamic from your real life:
        </p>
      </div>

      <div class="opponents-four-grid">
        {opponentCards.map((opp) => (
          <article class="opponent-profile-card">
            <div class="corner-reticle reticle-tl"></div>
            <div class="corner-reticle reticle-tr"></div>
            <div class="corner-reticle reticle-bl"></div>
            <div class="corner-reticle reticle-br"></div>

            <div class="opponent-portrait-wrap">
              <img src={opp.image} alt={opp.name} class="opponent-img" loading="lazy" />
              <div class="opponent-img-gradient"></div>
              <span class="opponent-role-tag">{opp.role}</span>
            </div>

