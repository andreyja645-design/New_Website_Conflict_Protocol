---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import { pickExisting, toCardLink } from "../lib/contentLinks";

const [patterns, techniques, situations] = await Promise.all([
  getCollection("patterns"),
  getCollection("techniques"),
  getCollection("situations")
]);

const featuredSituations = pickExisting(
  ["boss-keeps-expanding-the-ask", "you-end-up-apologizing", "after-everything-ive-done"],
  situations
).map((entry) => toCardLink(entry, "Situation"));

const resetLine = "I need a second to answer that clearly.";
const guide = [
  {
    href: "/situations/",
    title: "Situations",
    count: `${situations.length} worked conversations`,
    description: "Find a worked conversation and a line you can use."
  },
  {
    href: "/patterns/",
    title: "Pressure patterns",
    count: `${patterns.length} pressure patterns`,
    description: "Recognize guilt trips, shifting goalposts, and other tactics."
  },
  {
    href: "/techniques/",
    title: "Response techniques",
    count: `${techniques.length} response techniques`,
    description: "Learn ways to pause, respond, or set a limit."
  }
];
---

<BaseLayout
  title="Words ready before the room tilts | Conflict Protocol"
  description="A field guide for difficult conversations, with pressure patterns, response techniques, and scripts you can copy."
  canonical="/"
  image="/assets/home-hero-scripts-patterns-practice.webp"
  bodyClass="home-page"
>
  <div class="homepage-shell">
    <!-- Ambient Background Glows -->
    <div class="home-glow-orb orb-top"></div>
    <div class="home-glow-orb orb-mid"></div>

    <!-- ============================================================ -->
    <!-- HERO SECTION: MAYA AI TACTICAL COMMAND CENTER                -->
    <!-- ============================================================ -->
    <section class="home-hero-grid">
      <!-- Left: Copy & Primary CTAs -->
      <div class="hero-left-content">
        <h1 class="hero-title">
          Words ready before{" "}
          <span class="hero-title-highlight">the room tilts.</span>
        </h1>

        <p class="hero-lede">
          Find words for difficult conversations. Recognize the pressure, borrow a line, and practice holding your ground.
        </p>

        <div class="hero-cta-cluster">
          <a class="hero-btn-primary" href="/situations/">
            <span class="btn-icon">⚡</span>
            <span class="btn-text-group">
              <span class="btn-title">I NEED WORDS NOW</span>
              <span class="btn-subtitle">Worked scenes & copyable scripts ➔</span>
            </span>
          </a>

          <a class="hero-btn-secondary" href="/start-here/">
            <span class="btn-icon">🛡️</span>
            <span class="btn-text-group">
              <span class="btn-title">I FROZE & NEED A RESET</span>
              <span class="btn-subtitle">A line to ask for more time ➔</span>
            </span>
          </a>
        </div>
        <div class="home-quick-script">
          <div>
            <p>When someone pushes for an answer</p>
            <blockquote>“{resetLine}”</blockquote>
          </div>
          <div class="home-copy-action">
            <button type="button" class="home-copy-button" data-copy-script={resetLine}>Copy script</button>
            <span class="home-copy-status" role="status"></span>
          </div>
        </div>
        <a class="hero-quiz-link" href="/style-quiz/">Take the 12-question style quiz →</a>
      </div>

      <!-- Right: Perfectly Framed Hero Artwork (No Cropping!) -->
      <div class="hero-right-frame">
        <div class="hero-hologram-card">
          <div class="corner-reticle reticle-tl"></div>
          <div class="corner-reticle reticle-tr"></div>
          <div class="corner-reticle reticle-bl"></div>
          <div class="corner-reticle reticle-br"></div>

          <div class="hologram-hud-top">
            <div class="hologram-tag">
              <span class="beacon-mini"></span>
              <span>TACTICAL DOSSIER // RECONNAISSANCE</span>
            </div>
            <span class="hologram-status">100% BUFFER ACTIVE</span>
          </div>

          <!-- Image container preserving natural 16:9 aspect ratio -->
          <div class="hero-img-container">
            <img
              src="/assets/home-hero-scripts-patterns-practice.webp"
              alt="Script cards, pressure patterns, and practice prompts from Conflict Protocol."
              width="1600"
              height="900"
              class="hero-artwork-img"
            />
            <div class="scanline-overlay"></div>
            <div class="artwork-badge">
              <span>TACTICAL DECK: SCRIPTS & REACTION PATTERNS</span>
            </div>
          </div>

          <div class="hologram-hud-bottom">
            <span class="bottom-quote">"The first rule of conversational defense: never accept a rushed frame."</span>
            <span class="bottom-author">— Maya AI</span>
          </div>
        </div>
      </div>
    </section>

    <section class="home-section-block" aria-labelledby="guide-heading">
      <h2 class="section-main-heading" id="guide-heading">Explore the field guide</h2>
      <ul class="home-guide-links">
        {guide.map(({ href, title, count, description }) => (
          <li>
            <a href={href}>
              <span class="guide-count-pill">{count}</span>
              <strong>{title}</strong>
              <span>{description}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="featured-situations-block">
        <div class="featured-situations-header">
          <h3 class="featured-situations-title">Featured situations</h3>
          <a class="home-example-link" href="/situations/">Browse all {situations.length} situations →</a>
        </div>
        <div class="card-grid">
          {featuredSituations.map((card) => <ContentCard card={card} />)}
        </div>
      </div>
    </section>

    <section class="home-final-cta">
      <div class="corner-reticle reticle-tl"></div>
      <div class="corner-reticle reticle-tr"></div>
      <div class="corner-reticle reticle-bl"></div>
      <div class="corner-reticle reticle-br"></div>

      <div class="final-cta-inner">
        <h2 class="final-cta-title">
          See how the game works
        </h2>

        <p class="final-cta-desc">
          See how an opponent applies pressure, how you reply, and what the game tells you about your response.
        </p>

        <div class="final-cta-btn-cluster">
          <a class="hero-btn-primary" href="/play/#how-it-works">
            <span>See a sample turn →</span>
          </a>
          <a class="hero-btn-secondary" href="/style-quiz/" style="padding: 14px 24px;">
            <span>[ 🧭 TAKE THE 2-MIN STYLE QUIZ ]</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ============================================================ */
  /* HOMEPAGE STYLING // MAYA AI TACTICAL HUD (STYLE 1 STANDARD)  */
  /* ============================================================ */
  .homepage-shell {
    max-width: 1240px;
    margin: 0 auto;
    padding: 24px 24px 80px;
    position: relative;
    z-index: 1;
  }

  /* Ambient Glow Orbs */
  .home-glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
    pointer-events: none;
    z-index: -1;
  }
  .orb-top {
    top: -60px;
    right: -120px;
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.16) 0%, transparent 70%);
  }
  .orb-mid {
    top: 900px;
    left: -150px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(47, 184, 255, 0.1) 0%, transparent 70%);
  }

  /* Corner Reticles */
  .corner-reticle {
    position: absolute;
    width: 10px;
    height: 10px;
    pointer-events: none;
    z-index: 2;
  }
  .reticle-tl { top: 6px; left: 6px; border-top: 2px solid var(--accent); border-left: 2px solid var(--accent); }
  .reticle-tr { top: 6px; right: 6px; border-top: 2px solid var(--accent); border-right: 2px solid var(--accent); }
  .reticle-bl { bottom: 6px; left: 6px; border-bottom: 2px solid var(--accent); border-left: 2px solid var(--accent); }
  .reticle-br { bottom: 6px; right: 6px; border-bottom: 2px solid var(--accent); border-right: 2px solid var(--accent); }

  /* ============================================================ */
  /* HERO GRID (BALANCED 2-COLUMN)                                */
  /* ============================================================ */
  .home-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    padding-top: 20px;
    margin-bottom: 60px;
  }

  @media (max-width: 980px) {
    .home-hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .hero-left-content {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hero-title {
    font-family: var(--font-display);
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2rem, 4vw, 3.65rem);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: 0.03em;
    color: #fff;
    text-wrap: balance;
  }

  .hero-title-highlight {
    background: linear-gradient(135deg, #c084fc 0%, #ff2d9b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 30px rgba(168, 85, 247, 0.5);
  }

  .hero-lede {
    margin: 0;
    max-width: 48ch;
    font-size: 1.08rem;
    line-height: 1.65;
    color: var(--text-soft);
  }

  .hero-quiz-link {
    align-self: flex-start;
    color: var(--accent);
    font-weight: 600;
  }

  .hero-cta-cluster {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 16px;
    margin-top: 6px;
  }

  @media (max-width: 600px) {
    .homepage-shell { padding-inline: 18px; }
    .home-hero-grid { padding-top: 8px; }
    .hero-title { font-size: clamp(1.9rem, 8vw, 2.65rem); }
    .hero-left-content { gap: 14px; }
    .hero-cta-cluster { display: grid; gap: 10px; }
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 22px;
    background: linear-gradient(135deg, #8b3dff 0%, #d946ef 100%);
    border: 1px solid #e879f9;
    border-radius: 10px;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 0 25px rgba(168, 85, 247, 0.4);
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hero-btn-primary:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 0 35px rgba(168, 85, 247, 0.65), 0 0 15px #fff;
  }

  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 22px;
    background: rgba(22, 11, 42, 0.85);
    border: 1px solid rgba(168, 85, 247, 0.4);
    border-radius: 10px;
    color: #fff;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hero-btn-secondary:hover {
    background: rgba(35, 18, 62, 0.95);
    border-color: var(--accent);
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.3);
    transform: translateY(-2px);
  }

  .btn-icon {
    font-size: 1.2rem;
  }

  .btn-text-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .btn-title {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .btn-subtitle {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.04em;
  }

  /* Hero Hologram Right Col */
  .hero-right-frame {
    display: flex;
    justify-content: center;
  }

  .hero-hologram-card {
    position: relative;
    width: 100%;
    background: rgba(18, 9, 36, 0.85);
    border: 1.5px solid var(--line);
    border-radius: 18px;
    padding: 20px;
    box-shadow: var(--shadow-glow), 0 15px 40px rgba(0, 0, 0, 0.85);
    display: flex;
    flex-direction: column;
    gap: 14px;
    backdrop-filter: blur(16px);
  }

  .hologram-hud-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 10px;
  }

  .hologram-tag {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.12em;
  }

  .beacon-mini {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .hologram-status {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--emerald);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .hero-img-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(168, 85, 247, 0.3);
    background: #000;
  }

  .hero-artwork-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background-color: #0d0716;
    display: block;
  }

  .scanline-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%);
    background-size: 100% 3px;
    opacity: 0.22;
    pointer-events: none;
  }

  .artwork-badge {
    position: absolute;
    bottom: 10px;
    left: 10px;
    background: rgba(10, 5, 20, 0.85);
    border: 1px solid var(--line);
    padding: 3px 8px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: #fff;
    letter-spacing: 0.1em;
    backdrop-filter: blur(8px);
  }

  .hologram-hud-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 0, 0, 0.4);
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    padding: 10px 14px;
    font-size: 0.85rem;
    color: #e2e8f0;
  }

  .bottom-quote {
    font-style: italic;
  }

  .bottom-author {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent);
    font-weight: 700;
  }

  /* ============================================================ */
  /* SECTION HEADINGS                                             */
  /* ============================================================ */
  .home-section-block {
    margin-bottom: 75px;
  }

  .section-title-wrap {
    margin-bottom: 30px;
  }

  .section-main-heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #fff;
    text-transform: uppercase;
  }

  .home-quick-script {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 16px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    background: var(--bg-surface);
  }

  .home-quick-script p {
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .home-quick-script blockquote {
    margin: 0;
    line-height: 1.5;
  }

  .home-copy-action { position: relative; }

  .home-copy-button {
    min-height: 44px;
    padding: 8px 14px;
    border: 1px solid rgba(16, 185, 129, 0.45);
    border-radius: 8px;
    background: rgba(16, 185, 129, 0.15);
    color: #6ee7b7;
    font: 700 0.9rem var(--font-body);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .home-copy-button:hover {
    background: rgba(16, 185, 129, 0.28);
    border-color: var(--emerald, #10b981);
    transform: translateY(-1px);
  }

  .home-copy-button.is-copied {
    background: var(--emerald, #10b981);
    color: #06030b;
  }

  .home-copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .home-guide-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 12px;
    margin: 20px 0 36px;
    padding: 0;
    list-style: none;
  }

  .home-guide-links a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-surface);
    text-decoration: none;
  }

  .home-guide-links a:hover,
  .home-guide-links a:focus-visible { border-color: var(--accent); }

  .guide-count-pill {
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid rgba(168, 85, 247, 0.35);
    background: rgba(168, 85, 247, 0.12);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .home-guide-links strong {
    color: #fff;
    font-size: 1.08rem;
  }

  .home-guide-links a > span:last-child { color: var(--text-soft); line-height: 1.5; }
  .home-example-link { color: var(--accent); font-weight: 600; text-decoration: none; }
  .home-example-link:hover { text-decoration: underline; }

  .featured-situations-block {
    margin-top: 12px;
  }

  .featured-situations-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 16px;
    margin-bottom: 18px;
  }

  .featured-situations-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    color: #fff;
    letter-spacing: 0.03em;
  }

  @media (max-width: 460px) {
    .home-quick-script { grid-template-columns: 1fr; }
  }

  .home-final-cta {
    position: relative;
    background: linear-gradient(135deg, rgba(22, 11, 42, 0.9) 0%, rgba(12, 6, 24, 0.95) 100%);
    border: 1.5px solid var(--line-strong);
    border-radius: 20px;
    padding: 44px 32px;
    box-shadow: var(--shadow-glow), 0 15px 40px rgba(0, 0, 0, 0.85);
  }

  .final-cta-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .final-cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #fff;
    line-height: 1.15;
  }

  .final-cta-desc {
    font-size: 1.05rem;
    color: var(--text-soft);
    max-width: 600px;
  }

  .final-cta-btn-cluster {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 10px;
  }
</style>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>(".home-copy-button");
  const copyStatus = document.querySelector<HTMLElement>(".home-copy-status");

  if (copyButton && copyStatus && navigator.clipboard) {
    let resetTimer: number | undefined;
    copyButton.addEventListener("click", async () => {
      const script = copyButton.dataset.copyScript;
      if (!script) return;

      window.clearTimeout(resetTimer);
      copyStatus.textContent = "";
      try {
        await navigator.clipboard.writeText(script);
        copyButton.textContent = "Copied";
        copyButton.classList.add("is-copied");
        copyStatus.textContent = "Script copied to clipboard.";
      } catch {
        copyButton.textContent = "Copy failed";
        copyStatus.textContent = "Copy failed. Select the sentence to copy it manually.";
      }
      resetTimer = window.setTimeout(() => {
        copyButton.textContent = "Copy script";
        copyButton.classList.remove("is-copied");
        copyStatus.textContent = "";
      }, 2200);
    });
  }
</script>
