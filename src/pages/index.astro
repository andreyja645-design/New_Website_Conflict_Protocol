---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContentCard from "../components/ContentCard.astro";
import { toCardLink } from "../lib/contentLinks";

const [patterns, techniques, situations] = await Promise.all([
  getCollection("patterns"),
  getCollection("techniques"),
  getCollection("situations")
]);

const featuredEntries = [
  patterns.find((entry) => entry.data.slug === "gaslighting"),
  techniques.find((entry) => entry.data.slug === "grey-rock"),
  situations.find((entry) => entry.data.slug === "you-froze-in-a-meeting")
].filter(Boolean);

const featured = [
  toCardLink(featuredEntries[0], "Pattern"),
  toCardLink(featuredEntries[1], "Technique"),
  toCardLink(featuredEntries[2], "Situation")
];
---

<BaseLayout
  title="Words ready before the room tilts"
  description="A dark little field guide for spotting conversational pressure and having scripts ready."
  canonical="/"
  image="/assets/home-hero-scripts-patterns-practice.webp"
>
  <section class="hero shell">
    <div>
      <p class="eyebrow">Conflict Protocol field guide</p>
      <h1>Words ready before the room tilts.</h1>
      <p class="lede">
        You always think of the right answer three hours later. This site puts it in your mouth while
        the conversation is still happening.
      </p>
      <div class="entry-doors" aria-label="Choose a starting point">
        <a href="/start-here/">I freeze</a>
        <a href="/patterns/">Name the pattern</a>
        <a href="/situations/">Give me a script</a>
      </div>
    </div>
    <img
      src="/assets/home-hero-scripts-patterns-practice.webp"
      alt="Script cards, pressure patterns, and practice prompts from Conflict Protocol."
      width="1600"
      height="900"
    />
  </section>
  <section class="section-band shell">
    <div class="section-heading">
      <p class="eyebrow">Full field guide</p>
      <h2>Pick the door that matches the mess.</h2>
      <p>
        The catalog is live: fourteen pressure patterns, twelve counter-moves, and eight worked scenes
        with words you can lift. Start where your brain is currently on fire.
      </p>
    </div>
    <div class="card-grid">
      {featured.map((card) => <ContentCard card={card} />)}
    </div>
  </section>
</BaseLayout>
