---
import { getCollection } from "astro:content";
import ContentPage from "../../layouts/ContentPage.astro";
import { pickExisting, toCardLink } from "../../lib/contentLinks";

export async function getStaticPaths() {
  const entries = await getCollection("techniques");
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const [patterns, situations] = await Promise.all([
  getCollection("patterns"),
  getCollection("situations")
]);
const counters = pickExisting(entry.data.countersPatterns, patterns).map((item) => toCardLink(item, "Pattern"));
const relatedSituations = situations
  .filter((s) => s.data.techniques.includes(entry.data.slug))
  .map((item) => toCardLink(item, "Situation"));
---

<ContentPage
  entry={entry}
  section="Technique"
  description={`${entry.data.job} Risk: ${entry.data.risk}`}
  relatedGroups={[
    { title: "Patterns this counters", links: counters },
    { title: "Situations where this helps", links: relatedSituations }
  ]}
/>
