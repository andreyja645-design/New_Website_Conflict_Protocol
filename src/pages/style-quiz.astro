---
import BaseLayout from "../layouts/BaseLayout.astro";
import { COMMUNICATION_STYLES } from "../lib/communicationStyles";

const cleanDashes = (value: string) => value.replace(/[\u2013\u2014]/g, "-");

const styleResults = Object.fromEntries(
  COMMUNICATION_STYLES.map((style) => [
    style.id,
    {
      id: style.id,
      label: style.label,
      tagline: cleanDashes(style.tagline),
      category: style.category,
      categoryLabel: style.categoryLabel,
      detail: cleanDashes(style.detail),
      counterMeasure: cleanDashes(style.counterMeasure),
      image: style.image
    }
  ])
);

const questions = [
  {
    prompt: "Someone says, ‘You always make everything difficult.’ What happens first?",
    context: "A broad accusation lands before you have time to prepare.",
    options: [
      { label: "I stay flat and ask what specific issue they want addressed.", primary: "unmovable" },
      { label: "I name what I will discuss and what I will not accept.", primary: "operative" },
      { label: "I explain the full history so they cannot misunderstand me.", primary: "over-explainer" },
      { label: "I fire back with everything they have done wrong.", primary: "brawler" },
      { label: "I name the frustration I hear, then ask for one concrete example.", primary: "diplomat" },
      { label: "I say, ‘Impressive diagnosis. Did the internet give you a certificate?’", primary: "troll" }
    ]
  },
  {
    prompt: "A friend is upset, but their demand is unfair. How do you respond?",
    context: "Their feeling may be real even if their request is not.",
    options: [
      { label: "I acknowledge the feeling without agreeing to the demand.", primary: "diplomat" },
      { label: "I reframe the problem and ask what outcome they actually need.", primary: "tactician" },
      { label: "I agree for now because I cannot stand the tension.", primary: "appeaser" },
      { label: "I make a cutting joke about how dramatic they are being.", primary: "troll" },
      { label: "I keep my answer short and refuse to absorb their emotion.", primary: "unmovable" },
      { label: "I tell them they are being unreasonable and turn up the pressure.", primary: "brawler" }
    ]
  },
  {
    prompt: "You have already said no twice. They ask again. What do you do?",
    context: "The pressure is repetitive, not new information.",
    options: [
      { label: "I state the consequence and end the discussion if they continue.", primary: "operative" },
      { label: "I repeat the same short answer without adding new reasons.", primary: "unmovable" },
      { label: "I add more evidence so they finally understand why I said no.", primary: "over-explainer" },
      { label: "I change my answer, change it back, then suggest something unrelated.", primary: "wildcard" },
      { label: "I ask what new information they think should change my answer.", primary: "tactician" },
      { label: "I say, ‘Maybe the seventh time will unlock a different answer.’", primary: "troll" }
    ]
  },
  {
    prompt: "Someone takes a public jab at you in a meeting. Your instinct is to...",
    context: "There is an audience, and the room is watching your temperature.",
    options: [
      { label: "Name the tension calmly and bring the conversation back to the work.", primary: "diplomat" },
      { label: "Turn the jab into a precise question they have to answer.", primary: "tactician" },
      { label: "Raise my voice and make sure nobody thinks I am weak.", primary: "brawler" },
      { label: "Smile and embarrass them with a sharper joke.", primary: "troll" },
      { label: "Give the jab nothing and continue with the point I was making.", primary: "unmovable" },
      { label: "Explain why the comment is unfair and recount every relevant detail.", primary: "over-explainer" }
    ]
  },
  {
    prompt: "A request crosses a line, but saying no may disappoint someone. Which move feels most natural?",
    context: "This tests what you protect when approval and self-respect collide.",
    options: [
      { label: "A calm no, repeated once if needed.", primary: "unmovable" },
      { label: "A clear boundary with the next step if it is ignored.", primary: "operative" },
      { label: "I say yes, then feel resentful afterward.", primary: "appeaser" },
      { label: "I go quiet and hope the request disappears.", primary: "minimalist" },
      { label: "I recognize their disappointment while keeping my no intact.", primary: "diplomat" },
      { label: "I say, ‘Sure, should I cancel my life too, or is this enough?’", primary: "troll" }
    ]
  },
  {
    prompt: "The argument keeps circling. What is your next move?",
    context: "Repeating the same exchange is no longer producing information.",
    options: [
      { label: "Change the frame: ask what would actually resolve the issue.", primary: "tactician" },
      { label: "Slow down and name what emotion seems to be driving the loop.", primary: "diplomat" },
      { label: "Try several different positions until something sticks.", primary: "wildcard" },
      { label: "Restate my reasoning in greater detail.", primary: "over-explainer" },
      { label: "Stop adding material and repeat the one point that matters.", primary: "unmovable" },
      { label: "Ask whether they need a diagram before repeating the same jab.", primary: "troll" }
    ]
  },
  {
    prompt: "They attack your motives instead of your decision. How do you handle it?",
    context: "The topic has shifted from the issue to your character.",
    options: [
      { label: "I name the tactic and return to the decision in front of us.", primary: "operative" },
      { label: "I refuse the character debate and keep my answer unchanged.", primary: "unmovable" },
      { label: "I mock their amateur mind-reading.", primary: "troll" },
      { label: "I attack their character so they know how it feels.", primary: "brawler" },
      { label: "I acknowledge the concern beneath the accusation without defending myself.", primary: "diplomat" },
      { label: "I list evidence proving that my motives are good.", primary: "over-explainer" }
    ]
  },
  {
    prompt: "A high-stakes conversation starts getting emotional. What keeps you steady?",
    context: "The goal matters, but so does the relationship.",
    options: [
      { label: "A boundary I can enforce if the conversation becomes disrespectful.", primary: "operative" },
      { label: "Showing that I understand their concern before I answer it.", primary: "diplomat" },
      { label: "Giving them what they want so the emotion stops.", primary: "appeaser" },
      { label: "Saying as little as possible until it is over.", primary: "minimalist" },
      { label: "Asking a question that separates the emotion from the decision.", primary: "tactician" },
      { label: "Making a sarcastic comment to puncture the drama.", primary: "troll" }
    ]
  },
  {
    prompt: "Your first approach is clearly not working. What do you do next?",
    context: "Adaptation can be skillful, reactive, or chaotic.",
    options: [
      { label: "Read the new information and deliberately switch tools.", primary: "improviser" },
      { label: "Make the boundary more concrete and actionable.", primary: "operative" },
      { label: "Push harder and speak with more force.", primary: "brawler" },
      { label: "Abandon the plan and improvise without a clear objective.", primary: "wildcard" },
      { label: "Acknowledge what I missed and lower the temperature first.", primary: "diplomat" },
      { label: "Tell them this conversation clearly needs a laugh track.", primary: "troll" }
    ]
  },
  {
    prompt: "There is a long, uncomfortable silence. What are you most likely to do?",
    context: "Silence reveals how much pressure you feel to fill the space.",
    options: [
      { label: "Let it sit. I do not need to fill every gap.", primary: "minimalist" },
      { label: "Ask what they are feeling but not saying.", primary: "diplomat" },
      { label: "Use the pause to ask one question that changes the frame.", primary: "tactician" },
      { label: "Keep talking and add reasons until they respond.", primary: "over-explainer" },
      { label: "State what happens next if they refuse to engage.", primary: "operative" },
      { label: "Ask whether the silent-treatment performance has an intermission.", primary: "troll" }
    ]
  },
  {
    prompt: "The temperature rises suddenly. Which response sounds most like you?",
    context: "Your normal plan has been disrupted by a sharp emotional turn.",
    options: [
      { label: "I reassess and choose the tool that fits this new moment.", primary: "improviser" },
      { label: "I pause the exchange and state the condition for continuing.", primary: "unmovable" },
      { label: "I soften my position so they calm down.", primary: "appeaser" },
      { label: "I become inconsistent because I am trying to regain control.", primary: "wildcard" },
      { label: "I redirect the surge with one question about the real issue.", primary: "tactician" },
      { label: "I joke that they should save this energy for an audition.", primary: "troll" }
    ]
  },
  {
    prompt: "What would someone close to you say about your conflict style?",
    context: "Think about the pattern they see, not the person you hope to be.",
    options: [
      { label: "I change approach quickly when the situation changes.", primary: "improviser" },
      { label: "I find the angle that turns pressure into useful information.", primary: "tactician" },
      { label: "I get very quiet and reveal almost nothing.", primary: "minimalist" },
      { label: "I meet intensity with even more intensity.", primary: "brawler" },
      { label: "I am direct about my limits and what I will do next.", primary: "operative" },
      { label: "I always have a sarcastic comeback ready.", primary: "troll" }
    ]
  }
];
---

<BaseLayout
  title="Combat Style Test | Conflict Protocol"
  description="Take a 12-question pressure test to discover which Conflict Protocol combat style you use when conversations turn difficult."
  canonical="/style-quiz/"
  image="/assets/styles/Unmovable.webp"
  imageAlt="Conflict Protocol combat style assessment"
  bodyClass="style-quiz-page"
>
  <div class="quiz-shell shell">
    <div class="quiz-atmosphere" aria-hidden="true"></div>

    <header class="quiz-header">
      <a class="quiz-back-link" href="/styles/">← View all combat styles</a>
      <div class="quiz-kicker">MAYA AI // PRESSURE RESPONSE SCAN</div>
      <h1>WHAT IS YOUR <span>COMBAT STYLE?</span></h1>
      <p>Twelve situations. Choose what you would actually do when a conversation turns against you.</p>
    </header>

    <section class="quiz-console" aria-labelledby="quiz-console-title">
      <div class="console-rail" aria-hidden="true">
        <span class="rail-mark rail-mark-top"></span>
        <span class="rail-mark rail-mark-bottom"></span>
      </div>

      <div class="intro-panel" data-quiz-intro>
        <div class="intro-copy">
          <p class="console-label">TACTICAL BASELINE</p>
          <h2 id="quiz-console-title">Answer from instinct, not aspiration.</h2>
          <p>The game reads what you repeatedly do across a fight. This test uses the same eleven response patterns in a faster format.</p>
        </div>
        <div class="intro-specs" aria-label="Assessment details">
          <div><strong>12</strong><span>scenarios</span></div>
          <div><strong>6</strong><span>choices each</span></div>
          <div><strong>11</strong><span>possible styles</span></div>
        </div>
        <button class="primary-action" type="button" data-start-quiz>BEGIN ASSESSMENT <span>→</span></button>
      </div>

      <form class="question-panel" data-question-panel hidden novalidate>
        <div class="question-status">
          <span data-question-number>QUESTION 01 / 12</span>
          <div class="step-array" data-step-array aria-label="Assessment progress"></div>
        </div>

        <fieldset>
          <legend data-question-prompt tabindex="-1"></legend>
          <p class="question-context" data-question-context></p>
          <div class="answer-grid" data-answer-grid></div>
        </fieldset>

        <p class="answer-error" data-answer-error role="alert" hidden>Select the response closest to what you would really do.</p>

        <div class="question-actions">
          <button class="secondary-action" type="button" data-back-question>BACK</button>
          <button class="primary-action" type="submit" data-next-question>NEXT <span>→</span></button>
        </div>
      </form>

      <section class="result-panel" data-result-panel hidden aria-live="polite">
        <div class="result-visual">
          <img
            data-result-image
            src="/assets/styles/Unmovable.webp"
            alt=""
            width="941"
            height="1672"
            loading="lazy"
            decoding="async"
          />
          <div class="result-scanlines" aria-hidden="true"></div>
        </div>

        <div class="result-copy">
          <p class="console-label">SCAN COMPLETE // PRIMARY PATTERN</p>
          <div class="result-category" data-result-category></div>
          <h2 data-result-label></h2>
          <p class="result-tagline" data-result-tagline></p>

          <div class="result-readout">
            <h3>THE READ</h3>
            <p data-result-detail></p>
          </div>

          <div class="next-move">
            <h3>YOUR NEXT MOVE</h3>
            <p data-result-counter></p>
          </div>

          <p class="secondary-read">Secondary signal: <strong data-secondary-style></strong></p>

          <div class="result-actions">
            <a class="primary-action" data-result-link href="/styles/unmovable/">OPEN FULL DOSSIER <span>→</span></a>
            <button class="secondary-action review-action" type="button" data-toggle-review aria-expanded="false" aria-controls="answer-review">REVIEW YOUR ANSWERS <span>↓</span></button>
            <button class="secondary-action" type="button" data-retake-quiz>RETAKE TEST</button>
          </div>
        </div>

        <div class="answer-review" id="answer-review" data-answer-review hidden>
          <div class="answer-review-header">
            <p class="console-label">RESPONSE ANALYSIS // ALL 12 DECISIONS</p>
            <h3>YOUR ANSWERS, CLASSIFIED</h3>
            <p>Open any question to see your selected response and the combat move it represents.</p>
          </div>
          <div class="answer-review-list" data-answer-review-list></div>
        </div>
      </section>
    </section>

    <aside class="method-note">
      <strong>HOW THE READ WORKS</strong>
      <p>A recurring pressure trap can outweigh isolated good moves. A balanced spread of constructive choices reads as Improviser, while sparse engagement reads as Minimalist.</p>
    </aside>
  </div>

  <script type="application/json" id="style-quiz-questions" set:html={JSON.stringify(questions)}></script>
  <script type="application/json" id="style-quiz-results" set:html={JSON.stringify(styleResults)}></script>
</BaseLayout>

<script>
  type QuizOption = { label: string; primary: string };
  type QuizQuestion = { prompt: string; context: string; options: QuizOption[] };
  type StyleResult = {
    id: string;
    label: string;
    tagline: string;
    category: "constructive" | "trap" | "neutral";
    categoryLabel: string;
    detail: string;
    counterMeasure: string;
    image: string;
  };

  const questionsNode = document.querySelector<HTMLScriptElement>("#style-quiz-questions");
  const resultsNode = document.querySelector<HTMLScriptElement>("#style-quiz-results");
  const quizQuestions: QuizQuestion[] = JSON.parse(questionsNode?.textContent || "[]");
  const quizResults: Record<string, StyleResult> = JSON.parse(resultsNode?.textContent || "{}");

  const intro = document.querySelector<HTMLElement>("[data-quiz-intro]");
  const questionPanel = document.querySelector<HTMLFormElement>("[data-question-panel]");
  const resultPanel = document.querySelector<HTMLElement>("[data-result-panel]");
  const promptNode = document.querySelector<HTMLElement>("[data-question-prompt]");
  const contextNode = document.querySelector<HTMLElement>("[data-question-context]");
  const answerGrid = document.querySelector<HTMLElement>("[data-answer-grid]");
  const numberNode = document.querySelector<HTMLElement>("[data-question-number]");
  const stepArray = document.querySelector<HTMLElement>("[data-step-array]");
  const answerError = document.querySelector<HTMLElement>("[data-answer-error]");
  const backButton = document.querySelector<HTMLButtonElement>("[data-back-question]");
  const nextButton = document.querySelector<HTMLButtonElement>("[data-next-question]");

  let currentQuestion = 0;
  let answers: Array<number | null> = Array(quizQuestions.length).fill(null);

  const constructiveIds = ["unmovable", "operative", "diplomat", "tactician"];
  const trapIds = ["over-explainer", "appeaser", "brawler", "troll", "wildcard"];
  const styleOrder = [
    "unmovable", "operative", "diplomat", "tactician", "improviser",
    "minimalist", "over-explainer", "appeaser", "brawler", "troll", "wildcard"
  ];
  const moveLabels: Record<string, string> = {
    unmovable: "Grey Rock / Broken Record",
    operative: "Boundary / Consequence",
    diplomat: "Validation / Emotional Labeling",
    tactician: "Reframe / Verbal Aikido",
    improviser: "Adaptive Tool Switch",
    minimalist: "Minimal Response / Silence",
    "over-explainer": "JADE / Over-Explaining",
    appeaser: "Appeasement",
    brawler: "Reactive Escalation",
    troll: "Trolling / Sarcasm",
    wildcard: "Mixed Signal / Incoherence"
  };

  function renderSteps() {
    if (!stepArray) return;
    stepArray.innerHTML = quizQuestions.map((_, index) => {
      const state = index < currentQuestion ? "is-complete" : index === currentQuestion ? "is-current" : "";
      return `<span class="step ${state}" aria-hidden="true"></span>`;
    }).join("");
  }

  function renderQuestion() {
    const question = quizQuestions[currentQuestion];
    if (!question || !promptNode || !contextNode || !answerGrid || !numberNode || !backButton || !nextButton) return;

    numberNode.textContent = `QUESTION ${String(currentQuestion + 1).padStart(2, "0")} / ${quizQuestions.length}`;
    promptNode.textContent = question.prompt;
    contextNode.textContent = question.context;
    backButton.disabled = currentQuestion === 0;
    nextButton.innerHTML = currentQuestion === quizQuestions.length - 1 ? "REVEAL STYLE <span>→</span>" : "NEXT <span>→</span>";
    if (answerError) answerError.hidden = true;

    answerGrid.innerHTML = question.options.map((option, index) => {
      const checked = answers[currentQuestion] === index;
      return `
        <label class="answer-option ${checked ? "is-selected" : ""}">
          <input type="radio" name="quiz-answer" value="${index}" ${checked ? "checked" : ""} />
          <span class="answer-key">${String.fromCharCode(65 + index)}</span>
          <span class="answer-text">${option.label}</span>
          <span class="answer-check" aria-hidden="true">✓</span>
        </label>`;
    }).join("");

    answerGrid.querySelectorAll<HTMLInputElement>('input[name="quiz-answer"]').forEach((input) => {
      input.addEventListener("change", () => {
        answers[currentQuestion] = Number(input.value);
        answerGrid.querySelectorAll(".answer-option").forEach((option) => option.classList.remove("is-selected"));
        input.closest(".answer-option")?.classList.add("is-selected");
        if (answerError) answerError.hidden = true;
      });
    });

    renderSteps();
    promptNode.focus({ preventScroll: true });
  }

  function rankScores(scores: Record<string, number>) {
    return styleOrder
      .map((id) => ({ id, score: scores[id] || 0 }))
      .sort((a, b) => b.score - a.score || styleOrder.indexOf(a.id) - styleOrder.indexOf(b.id));
  }

  function calculateResult() {
    const scores = Object.fromEntries(styleOrder.map((id) => [id, 0])) as Record<string, number>;
    answers.forEach((optionIndex, questionIndex) => {
      if (optionIndex === null) return;
      const id = quizQuestions[questionIndex]?.options[optionIndex]?.primary;
      if (id) scores[id] += 1;
    });

    const topConstructive = rankScores(scores).find((entry) => constructiveIds.includes(entry.id))!;
    const topTrap = rankScores(scores).find((entry) => trapIds.includes(entry.id))!;
    const constructiveUsed = constructiveIds.filter((id) => scores[id] > 0);
    const constructiveRanking = rankScores(scores).filter((entry) => constructiveIds.includes(entry.id));
    const spreadIsBalanced = constructiveUsed.length >= 3 &&
      constructiveRanking[0].score - constructiveRanking[2].score <= 1;

    const overallRanking = rankScores(scores);
    let resultId = overallRanking[0].id;

    // Mirrors the game's priority: a repeated self-defeating pattern can define the whole run.
    if (topTrap.score >= 3 && topTrap.score > topConstructive.score) {
      resultId = topTrap.id;
    } else if (scores.minimalist >= 3 && scores.minimalist >= overallRanking[0].score) {
      resultId = "minimalist";
    } else if ((scores.improviser >= 2 && scores.improviser >= overallRanking[0].score - 1) || spreadIsBalanced) {
      resultId = "improviser";
    }

    const secondary = rankScores(scores).find((entry) => entry.id !== resultId) || { id: "minimalist", score: 0 };
    return { resultId, secondaryId: secondary.id };
  }

  function renderAnswerReview() {
    const list = document.querySelector<HTMLElement>("[data-answer-review-list]");
    if (!list) return;

    list.innerHTML = quizQuestions.map((question, questionIndex) => {
      const optionIndex = answers[questionIndex];
      const option = optionIndex === null ? null : question.options[optionIndex];
      const responseType = option ? moveLabels[option.primary] : "No answer recorded";
      return `
        <details class="answer-review-item">
          <summary>
            <span class="review-number">${String(questionIndex + 1).padStart(2, "0")}</span>
            <span class="review-question">${question.prompt}</span>
            <span class="review-marker" aria-hidden="true">+</span>
          </summary>
          <div class="review-detail">
            <div>
              <span>YOUR ANSWER</span>
              <p>${option?.label || "No answer recorded"}</p>
            </div>
            <div>
              <span>RESPONSE TYPE</span>
              <strong>${responseType}</strong>
            </div>
          </div>
        </details>`;
    }).join("");
  }

  function showResult() {
    const { resultId, secondaryId } = calculateResult();
    const result = quizResults[resultId];
    const secondary = quizResults[secondaryId];
    if (!result || !questionPanel || !resultPanel) return;

    questionPanel.hidden = true;
    resultPanel.hidden = false;
    resultPanel.dataset.tone = result.category;

    const image = document.querySelector<HTMLImageElement>("[data-result-image]");
    const category = document.querySelector<HTMLElement>("[data-result-category]");
    const label = document.querySelector<HTMLElement>("[data-result-label]");
    const tagline = document.querySelector<HTMLElement>("[data-result-tagline]");
    const detail = document.querySelector<HTMLElement>("[data-result-detail]");
    const counter = document.querySelector<HTMLElement>("[data-result-counter]");
    const secondaryStyle = document.querySelector<HTMLElement>("[data-secondary-style]");
    const resultLink = document.querySelector<HTMLAnchorElement>("[data-result-link]");

    if (image) { image.src = result.image; image.alt = `${result.label} combat style artwork`; }
    if (category) category.textContent = result.categoryLabel;
    if (label) label.textContent = result.label;
    if (tagline) tagline.textContent = result.tagline;
    if (detail) detail.textContent = result.detail;
    if (counter) counter.textContent = result.counterMeasure;
    if (secondaryStyle) secondaryStyle.textContent = secondary?.label || "No clear secondary pattern";
    if (resultLink) resultLink.href = `/styles/${result.id}/`;
    renderAnswerReview();

    resultPanel.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
  }

  document.querySelector("[data-start-quiz]")?.addEventListener("click", () => {
    if (!intro || !questionPanel) return;
    intro.hidden = true;
    questionPanel.hidden = false;
    renderQuestion();
  });

  questionPanel?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (answers[currentQuestion] === null) {
      if (answerError) answerError.hidden = false;
      answerGrid?.querySelector<HTMLInputElement>("input")?.focus();
      return;
    }
    if (currentQuestion === quizQuestions.length - 1) showResult();
    else { currentQuestion += 1; renderQuestion(); }
  });

  backButton?.addEventListener("click", () => {
    if (currentQuestion === 0) return;
    currentQuestion -= 1;
    renderQuestion();
  });

  document.querySelector("[data-toggle-review]")?.addEventListener("click", (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const review = document.querySelector<HTMLElement>("[data-answer-review]");
    if (!review) return;
    const opening = review.hidden;
    review.hidden = !opening;
    button.setAttribute("aria-expanded", String(opening));
    button.innerHTML = opening ? "HIDE ANSWER REVIEW <span>↑</span>" : "REVIEW YOUR ANSWERS <span>↓</span>";
    if (opening) review.scrollIntoView({ behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
  });

  document.querySelector("[data-retake-quiz]")?.addEventListener("click", () => {
    currentQuestion = 0;
    answers = Array(quizQuestions.length).fill(null);
    const review = document.querySelector<HTMLElement>("[data-answer-review]");
    const reviewButton = document.querySelector<HTMLButtonElement>("[data-toggle-review]");
    if (review) review.hidden = true;
    if (reviewButton) {
      reviewButton.setAttribute("aria-expanded", "false");
      reviewButton.innerHTML = "REVIEW YOUR ANSWERS <span>↓</span>";
    }
    if (resultPanel) resultPanel.hidden = true;
    if (intro) intro.hidden = false;
    intro?.scrollIntoView({ behavior: "auto", block: "center" });
  });
</script>

<style is:global>
  body.style-quiz-page { overflow-x: clip; }

  .quiz-shell {
    position: relative;
    overflow: clip;
    max-width: 1180px;
    margin: 0 auto;
    padding: 38px 24px 100px;
    isolation: isolate;
  }

  .quiz-atmosphere {
    position: absolute;
    z-index: -1;
    inset: -120px -80px auto 32%;
    height: 620px;
    pointer-events: none;
    background:
