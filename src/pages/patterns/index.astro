---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { toCardLink } from "../../lib/contentLinks";

const cards = (await getCollection("patterns")).map((entry) => toCardLink(entry, "Pattern"));
---

<BaseLayout title="Patterns" description="Name the conversational pressure pattern before it runs the room." canonical="/patterns/">
  <section class="section-band shell">
    <div class="section-heading">
      <p class="eyebrow">What are they doing?</p>
      <h1>Patterns</h1>
      <p class="lede">Not diagnoses. Behaviors. The point is to spot the move while you still have a sentence left.</p>
    </div>
    <div class="card-grid patterns-card-grid">
      {cards.map((card) => <ContentCard card={card} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .patterns-card-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  @media (max-width: 1080px) {
    .patterns-card-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 580px) {
    .patterns-card-grid {
      grid-template-columns: 1fr;
      max-width: 360px;
      margin: 0 auto;
    }
  }
</style>
