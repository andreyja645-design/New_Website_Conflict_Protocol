---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentCard from "../../components/ContentCard.astro";
import { toCardLink } from "../../lib/contentLinks";

const cards = (await getCollection("patterns")).map((entry) => toCardLink(entry, "Pattern"));
---

<BaseLayout title="Patterns" description="Name the conversational pressure pattern before it runs the room." canonical="/patterns/">
  <section class="section-band shell">
    <div class="section-heading">
      <p class="eyebrow">What are they doing?</p>
      <h1>Patterns</h1>
      <p class="lede">Not diagnoses. Behaviors. The point is to spot the move while you still have a sentence left.</p>
    </div>
    <div class="card-grid">
      {cards.map((card) => <ContentCard card={card} />)}
    </div>
  </section>
</BaseLayout>
