---
import { organizationSchema, websiteSchema } from "../lib/schema";
import { absoluteUrl, site } from "../lib/site";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
};

const {
  title = site.name,
  description = site.description,
  canonical = Astro.url.pathname,
  image = site.ogImage,
  imageAlt = description,
  jsonLd = [],
  bodyClass = ""
} = Astro.props;

const pageTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonicalUrl = absoluteUrl(canonical);
const imageUrl = absoluteUrl(image);
const schemas = [
  organizationSchema(),
  websiteSchema(),
  ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])
].filter(Boolean);

const navItems = [
  { href: "/play/", label: "Play" },
  { href: "/start-here/", label: "Start here" },
  { href: "/patterns/", label: "Patterns" },
  { href: "/techniques/", label: "Techniques" },
  { href: "/situations/", label: "Situations" },
  { href: "/about/", label: "About" }
];

const currentPath = Astro.url.pathname;
const isActivePath = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&family=Orbitron:wght@600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="nav shell" aria-label="Main navigation">
        <a class="brand" href="/" aria-label="Conflict Protocol home">
          <div class="brand-logo-wrap">
            <img src="/assets/cp-logo.webp" alt="" width="40" height="40" />
            <span class="logo-pulse-ring"></span>
          </div>
          <span class="brand-name">Conflict Protocol</span>
          <span class="nav-hud-badge">
            <span class="hud-beacon-dot"></span>
            <span>LIVE PROTOCOL</span>
          </span>
        </a>
        <div class="nav-links">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={[{ "is-active": isActivePath(item.href) }]}
                aria-current={isActivePath(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a class="practice-link" href="/play/">
            <span class="practice-link-glow"></span>
            <span>Play free ➔</span>
          </a>
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="shell footer-hud-strip">
        <div class="footer-hud-left">
          <span class="footer-radar-dot"></span>
          <span class="footer-hud-mono">CONFLICT PROTOCOL // NEURAL COMBAT SIMULATION v2.4</span>
        </div>
        <div class="footer-hud-right">
          <span class="footer-hud-status">● SYSTEM ALL-CLEAR // BUFFER READY</span>
        </div>
      </div>
      <div class="shell footer-grid">
        <div class="footer-brand-col">
          <a class="brand" href="/">
            <img src="/assets/cp-logo.webp" alt="" width="34" height="34" />
            <span class="brand-name">Conflict Protocol</span>
          </a>
          <p>You always think of the right answer three hours later. We are fixing that.</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href="/play/">Play</a>
          <a href="/start-here/">Start here</a>
          <a href="/patterns/">Patterns</a>
          <a href="/techniques/">Techniques</a>
          <a href="/situations/">Situations</a>
          <a href="/about/">About</a>
          <a href="/privacy/">Privacy</a>
          <a href="/llms.txt">LLMs</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
